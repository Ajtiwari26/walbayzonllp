<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#f97316">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    <!-- Fontshare: Satoshi + General Sans -->
    <link rel="preconnect" href="https://api.fontshare.com">
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700,900&amp;f[]=general-sans@400,500,600,700&amp;display=swap">

    <title>{{ page_title }}</title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    <!-- Tailwind CSS Play CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ['Satoshi', 'General Sans', 'ui-sans-serif', 'system-ui', 'sans-serif'],
              sans: ['Satoshi', 'General Sans', 'ui-sans-serif', 'system-ui', 'sans-serif'],
              mono: ['"JetBrains Mono"', 'monospace']
            },
            colors: {
              background: 'oklch(0.99 0.005 80)',
              foreground: 'oklch(0.18 0.022 55)',
              card: '#ffffff',
              border: 'oklch(0.91 0.015 70)',
              secondary: 'oklch(0.96 0.015 75)',
              muted: {
                DEFAULT: 'oklch(0.955 0.012 75)',
                foreground: 'oklch(0.45 0.018 55)'
              },
              primary: {
                DEFAULT: 'oklch(0.225 0.028 55)',
                foreground: 'oklch(0.985 0.008 80)'
              },
              brand: {
                coffee: 'oklch(0.225 0.028 55)',
                orange: 'oklch(0.78 0.16 65)',
                'orange-soft': 'oklch(0.92 0.07 75)',
                cream: 'oklch(0.985 0.008 80)'
              },
              // Compatibility classes
              'brand-orange': 'oklch(0.78 0.16 65)',
              'brand-orange-soft': 'oklch(0.92 0.07 75)',
              charcoal: 'oklch(0.18 0.022 55)',
              'soft-border': 'oklch(0.91 0.015 70)'
            },
            borderRadius: {
              '3xl': '1.625rem'
            }
          }
        }
      }
    </script>

    <style>
      /* ── CSS Custom Properties ── */
      :root {
        --color-primary: oklch(0.225 0.028 55);
        --color-primary-hover: oklch(0.18 0.022 55);
        --color-secondary: oklch(0.96 0.015 75);
        --color-charcoal: oklch(0.18 0.022 55);
        --color-soft-border: oklch(0.91 0.015 70);
        --color-brand-orange: oklch(0.78 0.16 65);
        --color-brand-orange-soft: oklch(0.92 0.07 75);

        --font-outfit: 'Satoshi', 'General Sans', sans-serif;
        --font-dmsans: 'Satoshi', 'General Sans', sans-serif;
        --font-mono: "JetBrains Mono", monospace;
      }

      /* ── Reset & Base Typography ── */
      html {
        scroll-behavior: smooth;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      body {
        font-family: 'Satoshi', 'General Sans', ui-sans-serif, system-ui, sans-serif;
        color: oklch(0.18 0.022 55);
        background-color: oklch(0.99 0.005 80);
        overflow-x: hidden;
        margin: 0;
      }

      h1, h2, h3, h4, h5, h6 {
        font-family: 'Satoshi', 'General Sans', sans-serif;
        letter-spacing: -0.02em;
        font-weight: 700;
      }

      a {
        color: inherit;
        text-decoration: none;
        transition: color 0.2s ease, background-color 0.2s ease, transform 0.15s ease;
      }

      /* Specific overrides to prevent Shopify theme conflict colors */
      header a:not(.btn-shimmer):not([class*="bg-"]):hover {
        color: oklch(0.78 0.16 65) !important;
      }
      footer a:not(.group):hover {
        color: oklch(0.78 0.16 65) !important;
      }

      /* Concentric Pulse Ring (Live Dot) */
      @keyframes pulseRing {
        0%   { transform: scale(1); opacity: 0.8; }
        100% { transform: scale(2.4); opacity: 0; }
      }

      .live-dot {
        width: 8px; height: 8px;
        border-radius: 50%;
        background: oklch(0.78 0.16 65);
        position: relative;
        display: inline-block;
        flex-shrink: 0;
      }

      .live-dot::after {
        content: '';
        position: absolute;
        inset: -3px;
        border-radius: 50%;
        border: 2px solid oklch(0.78 0.16 65);
        animation: pulseRing 1.8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
      }

      /* Shimmer Button Effect */
      .btn-shimmer {
        position: relative;
        overflow: hidden;
      }

      .btn-shimmer::before {
        content: '';
        position: absolute;
        top: 0; left: -100%;
        width: 100%; height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.45), transparent);
        transition: left 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .btn-shimmer:hover::before {
        left: 100%;
      }

      /* Scroll Reveal System */
      .reveal {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .reveal-left {
        opacity: 0;
        transform: translateX(-40px);
        transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .reveal-right {
        opacity: 0;
        transform: translateX(40px);
        transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .reveal-scale {
        opacity: 0;
        transform: scale(0.92);
        transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .delay-1 { transition-delay: 0.1s; }
      .delay-2 { transition-delay: 0.2s; }
      .delay-3 { transition-delay: 0.3s; }
      .delay-4 { transition-delay: 0.4s; }
      .delay-5 { transition-delay: 0.5s; }
      .delay-6 { transition-delay: 0.6s; }

      .revealed {
        opacity: 1 !important;
        transform: translateY(0) translateX(0) scale(1) !important;
      }

      /* Infinite Marquee */
      @keyframes marquee {
        0%   { transform: translateX(0%); }
        100% { transform: translateX(-50%); }
      }

      .animate-marquee {
        display: flex;
        width: max-content;
        animation: marquee 30s linear infinite;
      }

      .animate-marquee:hover {
        animation-play-state: paused;
      }

      /* Glassmorphic card */
      .glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.3);
      }

      /* Smooth card hover lift */
      .card-lift {
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                    box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                    border-color 0.35s ease;
      }

      .card-lift:hover {
        transform: translateY(-6px) scale(1.025);
        box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.1);
      }

      /* Timeline connector */
      .timeline-line {
        position: absolute;
        top: 50%; left: 0; right: 0;
        height: 2px;
        background: repeating-linear-gradient(
          90deg, #e5e7eb, #e5e7eb 8px, transparent 8px, transparent 16px
        );
        z-index: 0;
        transform: translateY(-50%);
      }
    </style>
  </head>

  <body>
    <main role="main" id="MainContent" class="focus-none" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
