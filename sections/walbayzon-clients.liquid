{%- assign client_blocks = section.blocks | where: "type", "client" -%}

<style>
  .clients-wrapper {
    padding: 100px 0;
    background: {{ section.settings.bg_color }};
  }
  .clients-title {
    text-align: center;
    font-family: Satoshi, sans-serif;
    font-size: 38px;
    font-weight: 800;
    color: {{ section.settings.title_color }};
    margin-bottom: 70px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .clients-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 30px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .client-card {
    border: 1px solid #e3ecff;
    border-radius: 22px;
    overflow: hidden;
    text-align: center;
    background: #ffffff;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .client-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(38, 24, 15, 0.08);
    border-color: #fc9f30;
  }
  .client-image {
    overflow: hidden;
    height: 160px;
    position: relative;
    background-color: #f7f3ed;
  }
  .client-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .client-card:hover .client-image img {
    transform: scale(1.06);
  }
  .client-logo {
    width: 90px;
    height: 90px;
    background: #ffffff;
    border-radius: 50%;
    margin: -45px auto 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #e3ecff;
    position: relative;
    z-index: 2;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.03);
    transition: border-color 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .client-card:hover .client-logo {
    border-color: #fc9f30;
    box-shadow: 0 10px 20px rgba(252, 159, 48, 0.1);
  }
  .client-logo img {
    width: 70px;
    height: 70px;
    object-fit: contain;
  }
  .client-info {
    padding: 15px 12px 20px;
  }
  .client-info h3 {
    font-family: Satoshi, sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #26180f;
    margin-bottom: 4px;
  }
  .client-info span {
    font-family: Satoshi, sans-serif;
    font-size: 13px;
    color: #777777;
    display: block;
  }
  .client-icons {
    margin-top: 10px;
    display: flex;
    justify-content: center;
    gap: 16px;
    font-size: 18px;
  }
  .client-icons a {
    color: #26180f;
    text-decoration: none;
    transition: transform 0.3s ease, color 0.3s ease;
    display: inline-flex;
    align-items: center;
  }
  .client-icons a:hover {
    transform: scale(1.2);
    color: #fc9f30;
  }

  /* Media Queries */
  @media (max-width: 1100px) {
    .clients-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }
  @media (max-width: 768px) {
    .clients-wrapper {
      padding: 60px 0;
    }
    .clients-title {
      font-size: 28px;
      margin-bottom: 40px;
      padding: 0 20px;
    }
    .clients-grid {
      display: flex;
      gap: 16px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 20px;
      padding-left: 20px;
      padding-right: 20px;
      -webkit-overflow-scrolling: touch;
    }
    .clients-grid::-webkit-scrollbar {
      height: 4px;
    }
    .clients-grid::-webkit-scrollbar-track {
      background: #f1f1f1;
      border-radius: 10px;
    }
    .clients-grid::-webkit-scrollbar-thumb {
      background: #fc9f30;
      border-radius: 10px;
    }
    .client-card {
      flex: 0 0 75%;
      scroll-snap-align: start;
    }
  }
  @media (max-width: 480px) {
    .client-card {
      flex: 0 0 85%;
    }
  }
</style>

<section class="clients-wrapper">
  <div class="container-fluid">
    <h2 class="clients-title">
      {{ section.settings.title }}
    </h2>

    <div class="clients-grid">
      {% if client_blocks.size > 0 %}
        {% for block in client_blocks %}
          <div class="client-card" {{ block.shopify_attributes }}>
            <div class="client-image">
              {% if block.settings.cover_image != blank %}
                <img src="{{ block.settings.cover_image | image_url: width: 600 }}" alt="{{ block.settings.title }}" loading="lazy">
              {% endif %}
            </div>
            
            <div class="client-logo">
              {% if block.settings.logo_image != blank %}
                <img src="{{ block.settings.logo_image | image_url: width: 200 }}" alt="{{ block.settings.title }} Logo" loading="lazy">
              {% endif %}
            </div>

            <div class="client-info">
              <h3>{{ block.settings.title }}</h3>
              <span>{{ block.settings.category }}</span>

              <div class="client-icons">
                {% if block.settings.website_url != blank %}
                  <a href="{{ block.settings.website_url }}" target="_blank" aria-label="Website">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
                  </a>
                {% endif %}
                {% if block.settings.instagram_url != blank %}
                  <a href="{{ block.settings.instagram_url }}" target="_blank" aria-label="Instagram">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
                  </a>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        {% comment %}
          Out of the box fallback displaying the 24 extracted brands
