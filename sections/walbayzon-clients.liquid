{% schema %}
{
  "name": "Walbayzon Clients",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Trusted by 100+ Growing & Established Brands Including"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#26180f"
    }
  ],
  "blocks": [
    {
      "type": "client",
      "name": "Brand",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Brand Name",
          "default": "Brand Name"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category/Subtitle",
          "default": "(Home Collection)"
        },
        {
          "type": "image_picker",
          "id": "cover_image",
          "label": "Card Cover Background Image"
        },
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Brand Logo (Circular)"
        },
        {
          "type": "url",
          "id": "website_url",
          "label": "Website URL"
        },
        {
          "type": "url",
          "id": "instagram_url",
          "label": "Instagram URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Walbayzon Clients"
    }
  ]
}
{% endschema %}
