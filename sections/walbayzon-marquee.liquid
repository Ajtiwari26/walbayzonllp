{% comment %}
  Walbayzon Platform Marquee Section
  Compatible with Shopify Theme Editor
{% endcomment %}

<section class="border-y border-neutral-900 bg-black py-12 overflow-hidden">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    
    {% if section.settings.title != blank %}
      <div class="mb-10 flex flex-row flex-wrap items-center justify-center gap-x-6 gap-y-4 md:gap-x-10 border-b border-neutral-900 pb-8 max-w-5xl mx-auto px-4">
        
        <!-- Far Left: Static logo 1 -->
        {% if section.settings.featured_platform_1 != blank %}
          <div class="text-neutral-400 hover:text-white transition-all duration-300 hover:scale-110 select-none flex items-center justify-center shrink-0">
            {% render 'walbayzon-platform-svg', platform_name: section.settings.featured_platform_1 %}
          </div>
        {% endif %}

        <!-- Left Center: Static logo 2 -->
        {% if section.settings.featured_platform_2 != blank %}
          <div class="text-neutral-400 hover:text-white transition-all duration-300 hover:scale-110 select-none flex items-center justify-center shrink-0">
            {% render 'walbayzon-platform-svg', platform_name: section.settings.featured_platform_2 %}
          </div>
        {% endif %}

        <!-- Center: Platforms we dominate Title -->
        <h2 class="text-center text-xs font-bold uppercase tracking-[0.25em] text-neutral-400 py-2 shrink-0 px-2">
          {{ section.settings.title }}
        </h2>

        <!-- Right Center: Static logo 3 -->
        {% if section.settings.featured_platform_3 != blank %}
          <div class="text-neutral-400 hover:text-white transition-all duration-300 hover:scale-110 select-none flex items-center justify-center shrink-0">
            {% render 'walbayzon-platform-svg', platform_name: section.settings.featured_platform_3 %}
          </div>
        {% endif %}

        <!-- Far Right: Static logo 4 -->
        {% if section.settings.featured_platform_4 != blank %}
          <div class="text-neutral-400 hover:text-white transition-all duration-300 hover:scale-110 select-none flex items-center justify-center shrink-0">
            {% render 'walbayzon-platform-svg', platform_name: section.settings.featured_platform_4 %}
          </div>
        {% endif %}

      </div>
    {% endif %}

    <div class="relative overflow-hidden w-full">
      <!-- Gradient masks on the sides -->
      <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24" style="background: linear-gradient(to right, #000000, transparent);"></div>
      <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24" style="background: linear-gradient(to left, #000000, transparent);"></div>
      
      <!-- Scrolling Track -->
      <div class="wb-marquee-track flex gap-0 whitespace-nowrap items-center">
        
        <!-- Four repeated groups for seamless ultrawide loop -->
        <div class="flex gap-0 animate-marquee shrink-0 items-center">
          {% for i in (1..4) %}
            {% for block in section.blocks %}
              {% assign p_name = block.settings.platform_name | downcase %}
              {% unless p_name == 'amazon' or p_name == 'walmart' or p_name == 'ebay' or p_name == 'etsy' %}
                <div class="flex items-center justify-center px-8 py-2 text-neutral-400 hover:text-white shrink-0 transition-all duration-300 hover:scale-125" {{ block.shopify_attributes }}>
                  {% assign platform_name = block.settings.platform_name %}
                  {% render 'walbayzon-platform-svg', platform_name: platform_name %}
                </div>
              {% endunless %}
            {% else %}
              <!-- Fallbacks -->
              {% assign fallbacks = "Flipkart,Meesho,JioMart,Ajio,Noon,Myntra,Blinkit,Zepto,Alibaba,Nykaa" | split: "," %}
              {% for item in fallbacks %}
                <div class="flex items-center justify-center px-8 py-2 text-neutral-400 hover:text-white shrink-0 transition-all duration-300 hover:scale-125">
                  {% render 'walbayzon-platform-svg', platform_name: item %}
                </div>
              {% endfor %}
            {% endfor %}
          {% endfor %}
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .wb-marquee-track {
    display: flex;
    overflow: hidden;
    user-select: none;
    gap: 0px;
  }
  .animate-marquee {
    display: flex;
    gap: 0px;
    animation: wb-marquee {{ section.settings.scroll_speed }}s linear infinite;
  }
  @keyframes wb-marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-25%); }
  }
</style>

{% schema %}
{
  "name": "Walbayzon Marquee",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Platforms we dominate"
    },
    {
      "type": "text",
      "id": "featured_platform_1",
      "label": "Featured Platform 1",
      "default": "eBay"
    },
    {
      "type": "text",
      "id": "featured_platform_2",
      "label": "Featured Platform 2",
      "default": "Amazon"
    },
    {
      "type": "text",
      "id": "featured_platform_3",
      "label": "Featured Platform 3",
      "default": "Walmart"
    },
    {
      "type": "text",
      "id": "featured_platform_4",
      "label": "Featured Platform 4",
      "default": "Etsy"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "s",
      "label": "Scrolling Duration (Speed)",
      "default": 35
    }
  ],
  "blocks": [
    {
      "type": "platform",
      "name": "Platform",
      "settings": [
        {
          "type": "text",
          "id": "platform_name",
          "label": "Platform Name",
          "default": "Amazon"
        },
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Platform Logo (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Walbayzon Marquee",
      "blocks": [
        { "type": "platform", "settings": { "platform_name": "Amazon" } },
        { "type": "platform", "settings": { "platform_name": "Flipkart" } },
        { "type": "platform", "settings": { "platform_name": "Meesho" } },
        { "type": "platform", "settings": { "platform_name": "JioMart" } },
        { "type": "platform", "settings": { "platform_name": "Ajio" } },
        { "type": "platform", "settings": { "platform_name": "Noon" } },
        { "type": "platform", "settings": { "platform_name": "Myntra" } },
        { "type": "platform", "settings": { "platform_name": "Blinkit" } },
        { "type": "platform", "settings": { "platform_name": "Zepto" } },
        { "type": "platform", "settings": { "platform_name": "Alibaba" } },
        { "type": "platform", "settings": { "platform_name": "Walmart" } },
        { "type": "platform", "settings": { "platform_name": "Nykaa" } }
      ]
    }
  ]
}
{% endschema %}
