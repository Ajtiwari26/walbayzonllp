{% comment %}
  Walbayzon Services Section
  Compatible with Shopify Theme Editor
{% endcomment %}

<!-- Google Fonts and Tailwind CSS -->
<link rel="preconnect" href="https://api.fontshare.com" />
<link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700,900&f[]=general-sans@400,500,600,700&display=swap" />
<script src="https://cdn.tailwindcss.com"></script>
<script>
  if (typeof tailwind !== 'undefined') {
    tailwind.config = {
      corePlugins: {
        preflight: false, // Prevents resetting your theme's default settings
      },
      theme: {
        extend: {
          fontFamily: {
            display: ['Satoshi','General Sans','ui-sans-serif','system-ui','sans-serif'],
            sans: ['Satoshi','General Sans','ui-sans-serif','system-ui','sans-serif'],
          },
          colors: {
            background: 'oklch(0.99 0.005 80)',
            foreground: 'oklch(0.18 0.022 55)',
            card: '#ffffff',
            border: 'oklch(0.91 0.015 70)',
            secondary: 'oklch(0.96 0.015 75)',
            muted: { DEFAULT: 'oklch(0.955 0.012 75)', foreground: 'oklch(0.45 0.018 55)' },
            primary: { DEFAULT: 'oklch(0.225 0.028 55)', foreground: 'oklch(0.985 0.008 80)' },
            brand: {
              coffee: 'oklch(0.225 0.028 55)',
              orange: 'oklch(0.78 0.16 65)',
              'orange-soft': 'oklch(0.92 0.07 75)',
              cream: 'oklch(0.985 0.008 80)',
            },
          },
          borderRadius: { '3xl': '1.625rem' },
        }
      }
    };
  }
</script>


<section id="services" class="relative py-16 sm:py-24 lg:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-5 lg:px-8">
    
    <!-- Section Header -->
    <div class="grid items-end gap-6 lg:grid-cols-[1fr_auto] lg:gap-8">
      <div>
        <p class="text-xs font-medium uppercase tracking-[0.2em] sm:text-sm" style="color: {{ section.settings.accent_color }};">
          {{ section.settings.sub_title }}
        </p>
        <h2 class="mt-4 max-w-3xl font-display text-3xl font-bold leading-[1.1] tracking-tight text-balance sm:text-4xl md:text-5xl lg:text-6xl text-foreground">
          {{ section.settings.title }}
        </h2>
      </div>
      {% if section.settings.link_text != blank %}
        <a href="{{ section.settings.link_url }}" class="hidden items-center gap-2 text-sm font-semibold text-foreground hover:opacity-80 lg:inline-flex">
          {{ section.settings.link_text }}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
            <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
          </svg>
        </a>
      {% endif %}
    </div>

    <!-- Services Grid -->
    <div class="mt-12 grid gap-px overflow-hidden rounded-3xl border border-border bg-border sm:mt-16 sm:grid-cols-2 lg:grid-cols-3">
      {% for block in section.blocks %}
        <div class="group relative bg-card p-6 transition-colors duration-300 hover:bg-secondary/40 sm:p-8" {{ block.shopify_attributes }}>
          <div class="flex items-start justify-between">
            
            <!-- Service Icon -->
            <div class="grid h-12 w-12 place-items-center rounded-2xl bg-primary text-primary-foreground transition-colors duration-300 group-hover:bg-brand-orange group-hover:text-primary" 
                 style="background-color: {{ section.settings.icon_bg_color }}; color: {{ section.settings.icon_color }};">
              {% case block.settings.icon %}
                {% when 'shopping-bag' %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                {% when 'trending-up' %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
                {% when 'globe' %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20"/></svg>
                {% when 'sparkles' %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/></svg>
                {% when 'bar-chart' %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><line x1="12" x2="12" y1="20" y2="10"/><line x1="18" x2="18" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="16"/></svg>
                {% when 'rocket' %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09Z"/><path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2Z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>
                {% else %}
                  <span>{{ block.settings.custom_emoji }}</span>
              {% endcase %}
            </div>

            <!-- Service Index -->
            <span class="font-display text-xs font-bold tracking-wider text-muted-foreground">{{ block.settings.tag }}</span>
          </div>

          <!-- Service Title & Description -->
          <h3 class="mt-6 font-display text-xl font-bold tracking-tight sm:mt-8 sm:text-2xl text-foreground">{{ block.settings.title }}</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{{ block.settings.description }}</p>
          
          {% if block.settings.link_url != blank %}
            <a href="{{ block.settings.link_url }}" class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-foreground hover:opacity-85">
              {{ block.settings.link_label | default: "Learn more" }}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Walbayzon Services",
  "settings": [
    {
      "type": "text",
      "id": "sub_title",
      "label": "Sub Title",
      "default": "— What we do"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Every lever a modern brand needs to win the marketplace."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Text Color",
      "default": "#f97316"
    },
    {
      "type": "color",
      "id": "icon_bg_color",
      "label": "Icon Background Color",
      "default": "#2c221e"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#fbf8f5"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "Talk to a strategist"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon Select",
          "options": [
            { "value": "shopping-bag", "label": "Shopping Bag" },
            { "value": "trending-up", "label": "Trending Up" },
            { "value": "globe", "label": "Globe" },
            { "value": "sparkles", "label": "Sparkles" },
            { "value": "bar-chart", "label": "Bar Chart" },
            { "value": "rocket", "label": "Rocket" },
            { "value": "custom", "label": "Custom Emoji/Text" }
          ],
          "default": "shopping-bag"
        },
        {
          "type": "text",
          "id": "custom_emoji",
          "label": "Custom Emoji (if selected Custom above)",
          "default": "📦"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag/Index Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Service Title",
          "default": "Marketplace Launch"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Service Description",
          "default": "From listing to launch — we set up your storefront on every major marketplace with conversion-first creative."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link Label",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Walbayzon Services",
      "blocks": [
        {
          "type": "service",
          "settings": {
            "icon": "shopping-bag",
            "tag": "01",
            "title": "Marketplace Launch",
            "description": "From listing to launch — we set up your storefront on every major marketplace with conversion-first creative."
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "trending-up",
            "tag": "02",
            "title": "Performance Ads",
            "description": "Sponsored Products, Brands & Display campaigns engineered to lower ACoS and compound revenue month over month."
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "globe",
            "tag": "03",
            "title": "Global Expansion",
            "description": "Take your brand to Amazon US, UAE, KSA and beyond with localized creative, compliance and logistics."
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "sparkles",
            "tag": "04",
            "title": "Brand & Creative",
            "description": "A+ Content, Storefronts, lifestyle photography and video that makes shoppers stop scrolling."
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "bar-chart",
            "tag": "05",
            "title": "Analytics & Insights",
            "description": "Custom dashboards that turn marketplace chaos into clear, weekly decisions for your team."
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "rocket",
            "tag": "06",
            "title": "Quick Commerce",
            "description": "Win the 10-minute shelf on Blinkit, Zepto & Instamart with assortment and pricing strategy."
          }
        }
      ]
    }
  ]
}
{% endschema %}
