        <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr] lg:gap-20">
          <div>
            <p class="text-sm font-medium uppercase tracking-[0.2em] text-brand-orange">{{ section.settings.footer_cta_sub }}</p>
            <h2 class="mt-6 font-display text-3xl font-bold leading-[1.05] tracking-tight text-balance sm:text-4xl md:text-5xl lg:text-6xl">{{ section.settings.footer_cta_title }}</h2>
            <p class="mt-6 max-w-xl text-base text-primary-foreground/70 sm:text-lg">{{ section.settings.footer_cta_desc }}</p>
          </div>
          <div class="flex flex-col justify-end gap-4">
            {% if section.settings.footer_btn1_text != blank %}
              <a href="{{ section.settings.footer_btn1_url }}" class="group inline-flex items-center justify-between gap-3 rounded-full bg-brand-orange px-5 py-3 text-sm font-semibold text-primary transition-all hover:bg-brand-orange-soft">
                <span>{{ section.settings.footer_btn1_text }}</span>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
              </a>
            {% endif %}
            {% if section.settings.footer_btn2_text != blank %}
              <a href="{{ section.settings.footer_btn2_url }}" class="group inline-flex items-center justify-between gap-3 rounded-full border border-primary-foreground/20 px-5 py-3 text-sm font-medium text-primary-foreground transition-all hover:border-brand-orange hover:text-brand-orange">
                <span class="flex min-w-0 items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
                  <span class="truncate">{{ section.settings.footer_btn2_text }}</span>
                </span>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
              </a>
            {% endif %}
          </div>
        </div>

        <div class="mt-20 grid gap-12 border-t border-primary-foreground/10 pt-16 md:grid-cols-2 lg:grid-cols-5">
          <div class="lg:col-span-2">
            <div class="flex items-center gap-2.5">
              <div class="grid h-10 w-10 place-items-center rounded-full bg-brand-orange"><span class="font-display text-base font-black text-primary">W.</span></div>
              <span class="font-display text-xl font-bold tracking-tight">{{ section.settings.footer_logo_text }}</span>
            </div>
            <p class="mt-6 max-w-sm text-sm leading-relaxed text-primary-foreground/65">{{ section.settings.footer_logo_desc }}</p>
          </div>
          {% for block in section.blocks %}
            {% if block.type == 'footer_menu' %}
              <div>
                <h4 class="text-sm font-semibold uppercase tracking-[0.15em] text-brand-orange">{{ block.settings.title }}</h4>
                <ul class="mt-5 space-y-3">
                  {% for link in linklists[block.settings.menu].links %}
