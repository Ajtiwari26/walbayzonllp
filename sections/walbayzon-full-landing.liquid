{% comment %}
  Walbayzon All-in-One Landing Page Section
  Compatible with Shopify Theme Editor
{% endcomment %}

<style>
  .wb-landing-wrapper {
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    font-family: 'Satoshi','General Sans',ui-sans-serif,system-ui,sans-serif;
    background: oklch(0.99 0.005 80);
    color: oklch(0.18 0.022 55);
  }
  .wb-landing-wrapper h1,
  .wb-landing-wrapper h2,
  .wb-landing-wrapper h3,
  .wb-landing-wrapper h4 {
    font-family: 'Satoshi','General Sans',sans-serif;
    letter-spacing: -0.02em;
    font-weight: 700;
  }
  .gradient-warm { background: linear-gradient(135deg, oklch(0.98 0.02 75) 0%, oklch(0.94 0.05 70) 100%); }
  .gradient-coffee { background: linear-gradient(135deg, oklch(0.22 0.025 50) 0%, oklch(0.16 0.02 45) 100%); }
  .gradient-orange { background: linear-gradient(135deg, oklch(0.82 0.16 65) 0%, oklch(0.72 0.18 50) 100%); }
  
  .wb-marquee-track {
    display: flex;
    overflow: hidden;
    user-select: none;
    gap: 0px;
  }
  .animate-marquee {
    display: flex;
    gap: 0px;
    animation: wb-marquee 35s linear infinite;
  }
  @keyframes wb-marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-25%); }
  }
  .fade-up { animation: fadeUp .8s cubic-bezier(.22,1,.36,1) both; }
  @keyframes fadeUp { from { opacity:0; transform: translateY(16px) } to { opacity:1; transform: translateY(0) } }

  /* Smooth transitions and hover overrides to match Netlify */
  #services .group {
    transition: background-color 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
  }
  #services .group:hover {
    background-color: oklch(0.96 0.015 75) !important; /* Dull cream hover color */
  }
  #services .group .grid.h-12 {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
  }
  #services .group:hover .grid.h-12 {
    background-color: oklch(0.78 0.16 65) !important; /* Brand Orange on hover */
    color: oklch(0.225 0.028 55) !important; /* Coffee/Black icon on hover */
  }

  /* Hero rotator styles */
  .hero-rotator-slide {
    opacity: 0;
    transform: scale(0.88) translateY(0);
    transition: opacity 0.8s ease-in-out, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hero-rotator-slide.active {
    opacity: 1 !important;
    transform: scale(1) translateY(0) !important;
    pointer-events: auto !important;
  }

  /* Network Map styles */
  .network-grid-line {
    stroke: #26180f;
    stroke-width: 1.2;
    stroke-dasharray: 4 8;
    stroke-opacity: 0.08;
  }
  .network-continent {
    fill: #ffffff;
    stroke: #e8e0d7;
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-opacity: 0.45;
  }
  .animate-width {
    stroke-opacity: 0.08;
    stroke-width: 2px;
    transition: stroke-width 0.3s, stroke-opacity 0.3s;
  }
  @keyframes pulseFlow {
    0% { stroke-dashoffset: 240px; }
    100% { stroke-dashoffset: 0; }
  }
  .signal-line {
    stroke-dasharray: 60 180;
    stroke-dashoffset: 240px;
    stroke-opacity: 0.85;
    stroke-width: 3px;
    pointer-events: none;
    animation: 3s linear infinite pulseFlow;
  }
  .delay-wave-0 { animation-delay: 0s; }
  .delay-wave-1 { animation-delay: -2.25s; }
  .delay-wave-2 { animation-delay: -1.5s; }
  .delay-wave-3 { animation-delay: -0.75s; }
  .network-node {
    transform-box: fill-box;
    transform-origin: 50%;
    cursor: pointer;
    will-change: transform;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    transform: scale(1);
  }
  .network-node:hover {
    transform: scale(1.25);
  }
  .network-node:hover .node-bg {
    stroke: #fc9f30;
    stroke-width: 2px;
  }
  .network-node .node-label {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease-in-out;
  }
  .network-node:hover .node-label {
    opacity: 1;
  }
  .center-node {
    cursor: default;
  }
  .center-node:hover {
    transform: scale(1.05);
  }
</style>

<div class="wb-landing-wrapper min-h-screen bg-background">

  <!-- ================= ANNOUNCEMENT BAR ================= -->
  {% if section.settings.show_announcement %}
    <div class="w-full bg-brand-orange-soft">
      <div class="mx-auto flex max-w-7xl items-center justify-center gap-2 px-3 py-2 text-center text-[11px] font-medium text-foreground sm:gap-3 sm:px-5 sm:text-sm lg:px-8">
        <span class="line-clamp-2 sm:line-clamp-1">{{ section.settings.announcement_text }}</span>
        {% if section.settings.announcement_link != blank %}
          <a href="{{ section.settings.announcement_link }}" class="shrink-0 rounded-full bg-brand-orange px-3 py-1 text-xs font-semibold text-primary shadow-sm transition-transform hover:scale-[1.03] inline-flex">
            {{ section.settings.announcement_link_text }}
          </a>
        {% endif %}
      </div>
    </div>
  {% endif %}

  <!-- ================= HEADER ================= -->
  {% if section.settings.show_header %}
    <header class="w-full border-b border-border/60 bg-background/80 backdrop-blur-xl sticky top-0 z-50">
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 lg:h-20 lg:px-8">
        <a href="#" class="flex items-center gap-2.5">
          <div class="grid h-9 w-9 place-items-center rounded-full bg-primary">
            <span class="font-display text-base font-black text-primary-foreground">W<span class="text-brand-orange">.</span></span>
          </div>
          <span class="font-display text-lg font-bold tracking-tight text-foreground">{{ section.settings.header_logo_text }}</span>
        </a>
        <nav class="hidden items-center gap-1 lg:flex">
          {% for link in linklists[section.settings.header_menu].links %}
            <a href="{{ link.url }}" class="rounded-full px-4 py-2 text-sm font-medium text-foreground/80 hover:bg-secondary hover:text-foreground">
              {{ link.title }}
            </a>
          {% else %}
            <a href="#services" class="rounded-full px-4 py-2 text-sm font-medium text-foreground/80 hover:bg-secondary hover:text-foreground">Services</a>
            <a href="#how" class="rounded-full px-4 py-2 text-sm font-medium text-foreground/80 hover:bg-secondary hover:text-foreground">How We Work</a>
            <a href="#mastercourse" class="rounded-full px-4 py-2 text-sm font-medium text-foreground/80 hover:bg-secondary hover:text-foreground">Mastercourse</a>
          {% endfor %}
        </nav>
        <div class="hidden items-center gap-5 lg:flex">
          {% if section.settings.header_btn1_text != blank %}
            <div class="relative">
              <span aria-hidden class="absolute inset-0 translate-x-1.5 translate-y-1.5 rounded-full bg-foreground"></span>
              <a href="{{ section.settings.header_btn1_url }}" class="relative inline-flex items-center rounded-full border-2 border-foreground bg-background px-5 py-2.5 text-sm font-semibold text-foreground transition-transform duration-150 hover:translate-x-1.5 hover:translate-y-1.5">{{ section.settings.header_btn1_text }}</a>
            </div>
          {% endif %}
          {% if section.settings.header_btn2_text != blank %}
            <div class="relative">
              <span aria-hidden class="absolute inset-0 translate-x-1.5 translate-y-1.5 rounded-full bg-foreground"></span>
              <a href="{{ section.settings.header_btn2_url }}" class="relative inline-flex items-center rounded-full border-2 border-foreground bg-brand-orange px-5 py-2.5 text-sm font-semibold text-foreground transition-transform duration-150 hover:translate-x-1.5 hover:translate-y-1.5">{{ section.settings.header_btn2_text }}</a>
            </div>
          {% endif %}
        </div>
      </div>
    </header>
  {% endif %}

  <!-- ================= HERO ================= -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 gradient-warm"></div>
    <div class="absolute -top-32 left-1/2 -z-10 h-[500px] w-[800px] -translate-x-1/2 rounded-full bg-brand-orange/20 blur-3xl"></div>
    <div class="mx-auto max-w-7xl px-4 pb-20 pt-12 sm:px-5 sm:pb-24 sm:pt-16 lg:px-8 lg:pb-32 lg:pt-24">
      <div class="mx-auto max-w-4xl text-center fade-up">
        {% if section.settings.hero_badge != blank %}
          <div class="inline-flex items-center gap-2 rounded-full border border-border bg-background/60 px-3 py-1.5 text-[11px] font-medium text-foreground/70 backdrop-blur sm:px-4 sm:text-xs">
            <span class="relative flex h-2 w-2"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-orange opacity-75"></span><span class="relative inline-flex h-2 w-2 rounded-full bg-brand-orange"></span></span>
            <span>{{ section.settings.hero_badge }}</span>
          </div>
        {% endif %}
        <h1 class="mt-6 font-display text-[2.5rem] font-bold leading-[1.2] tracking-tight text-balance text-foreground sm:mt-7 sm:text-6xl md:text-7xl lg:text-[6.5rem] lg:leading-[1.25] hero-rotator-container">
          <span class="grid justify-center">
            <!-- Slide 1 -->
            <span class="hero-rotator-slide col-start-1 row-start-1 active transition-all duration-300">
              The #1 <span class="inline-block rounded-xl bg-brand-orange px-2 py-0.5 text-foreground shadow-[3px_3px_0_0_oklch(0.18_0.022_55)] sm:px-3 hero-orange-block">Trusted partner</span> in <span class="inline-block rounded-xl bg-brand-orange px-2 py-0.5 text-foreground shadow-[3px_3px_0_0_oklch(0.18_0.022_55)] sm:px-3 hero-orange-block">Brand Building</span>.
            </span>
            <!-- Slide 2 -->
            <span class="hero-rotator-slide col-start-1 row-start-1 pointer-events-none opacity-0 transition-all duration-300">
              The #1 <span class="inline-block rounded-xl bg-brand-orange px-2 py-0.5 text-foreground shadow-[3px_3px_0_0_oklch(0.18_0.022_55)] sm:px-3 hero-orange-block">Top-rated expert</span> in <span class="inline-block rounded-xl bg-brand-orange px-2 py-0.5 text-foreground shadow-[3px_3px_0_0_oklch(0.18_0.022_55)] sm:px-3 hero-orange-block">Global Scaling</span>.
            </span>
            <!-- Slide 3 -->
            <span class="hero-rotator-slide col-start-1 row-start-1 pointer-events-none opacity-0 transition-all duration-300">
              The #1 <span class="inline-block rounded-xl bg-brand-orange px-2 py-0.5 text-foreground shadow-[3px_3px_0_0_oklch(0.18_0.022_55)] sm:px-3 hero-orange-block">Go-to choice</span> in <span class="inline-block rounded-xl bg-brand-orange px-2 py-0.5 text-foreground shadow-[3px_3px_0_0_oklch(0.18_0.022_55)] sm:px-3 hero-orange-block">Worldwide Growth</span>.
            </span>
          </span>
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-base text-muted-foreground sm:mt-7 sm:text-lg md:text-xl">{{ section.settings.hero_subheading }}</p>
        <div class="mt-8 flex flex-col items-center justify-center gap-5 sm:mt-9 sm:flex-row">
          {% if section.settings.hero_btn1_text != blank %}
            <div class="relative w-full sm:w-auto">
              <span aria-hidden class="absolute inset-0 translate-x-1.5 translate-y-1.5 rounded-full bg-foreground"></span>
              <a href="{{ section.settings.hero_btn1_url }}" class="relative inline-flex w-full items-center justify-center rounded-full border-2 border-foreground bg-background px-6 py-3 text-base font-semibold text-foreground transition-transform duration-150 hover:translate-x-1.5 hover:translate-y-1.5 sm:w-auto">{{ section.settings.hero_btn1_text }}</a>
            </div>
          {% endif %}
          {% if section.settings.hero_btn2_text != blank %}
            <div class="relative w-full sm:w-auto">
              <span aria-hidden class="absolute inset-0 translate-x-1.5 translate-y-1.5 rounded-full bg-foreground"></span>
              <a href="{{ section.settings.hero_btn2_url }}" class="relative inline-flex w-full items-center justify-center rounded-full border-2 border-foreground bg-brand-orange px-6 py-3 text-base font-semibold text-foreground transition-transform duration-150 hover:translate-x-1.5 hover:translate-y-1.5 sm:w-auto">{{ section.settings.hero_btn2_text }}</a>
            </div>
          {% endif %}
        </div>
        <div class="mt-10 flex flex-col items-center justify-center gap-3 text-sm text-muted-foreground sm:flex-row sm:gap-6">
          <div class="flex items-center gap-1.5 text-brand-orange" id="hero-stars-landing">
            {% for i in (1..5) %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            {% endfor %}
          </div>
          <span class="text-xs sm:text-sm">{{ section.settings.hero_rating_desc }}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= MARQUEE ================= -->
  <section class="border-y border-neutral-900 bg-black py-12 overflow-hidden">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      {% if section.settings.marquee_title != blank %}
        <p class="mb-8 text-center text-xs font-semibold uppercase tracking-[0.2em] text-neutral-400">{{ section.settings.marquee_title }}</p>
      {% endif %}
      <div class="relative overflow-hidden w-full">
        <!-- Gradient masks on the sides -->
        <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24" style="background: linear-gradient(to right, #000000, transparent);"></div>
        <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24" style="background: linear-gradient(to left, #000000, transparent);"></div>
        
        <!-- Scrolling Track -->
        <div class="wb-marquee-track flex gap-0 whitespace-nowrap items-center">
          
          <!-- Four repeated groups for seamless ultrawide loop -->
          <div class="flex gap-0 animate-marquee shrink-0 items-center">
            {% for i in (1..4) %}
              {% for block in section.blocks %}
                {% if block.type == 'platform' %}
                  <div class="flex items-center justify-center px-8 py-2 text-neutral-400 hover:text-white shrink-0 transition-all duration-300 hover:scale-125" {{ block.shopify_attributes }}>
                    {% render 'walbayzon-platform-svg', platform_name: block.settings.title %}
                  </div>
                {% endif %}
              {% else %}
                <!-- Fallbacks -->
                {% assign fallbacks = "Amazon,Flipkart,Meesho,JioMart,Ajio,Noon,Myntra,Blinkit,Zepto,Alibaba,Walmart,Nykaa" | split: "," %}
                {% for item in fallbacks %}
                  <div class="flex items-center justify-center px-8 py-2 text-neutral-400 hover:text-white shrink-0 transition-all duration-300 hover:scale-125">
                    {% render 'walbayzon-platform-svg', platform_name: item %}
                  </div>
                {% endfor %}
              {% endfor %}
            {% endfor %}
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ================= NETWORK MAP ================= -->
  {% if section.settings.show_network_map %}
    <section class="py-20 md:py-24 relative overflow-hidden" style="background: linear-gradient(to bottom, #fdfbf8 0%, #f7f3ed 100%);">
      <div class="max-w-7xl mx-auto px-5">
        <div class="text-center max-w-3xl mx-auto mb-16">
          {% if section.settings.network_sub_title != blank %}
            <span class="text-brand-orange font-bold text-[13px] uppercase tracking-wider bg-brand-orange/10 px-3 py-1 rounded-full">
              {{ section.settings.network_sub_title }}
            </span>
          {% endif %}
          <h2 class="font-display text-[32px] sm:text-[42px] font-extrabold text-charcoal tracking-tight mt-4 leading-tight">
            {{ section.settings.network_title }}
          </h2>
          {% if section.settings.network_description != blank %}
            <p class="text-neutral-500 mt-4 text-sm sm:text-base max-w-[650px] mx-auto">
              {{ section.settings.network_description }}
            </p>
          {% endif %}
        </div>

        <div class="flex items-center justify-center overflow-x-auto w-full pb-8">
          <div class="min-w-[1000px] w-full max-w-[1211px] h-auto overflow-hidden relative">
            <svg width="1211" height="590" viewBox="0 0 1211 590" fill="none" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
              <g opacity="0.4">
                <line x1="50" y1="100" x2="1160" y2="100" class="network-grid-line" />
                <line x1="50" y1="200" x2="1160" y2="200" class="network-grid-line" />
                <line x1="50" y1="300" x2="1160" y2="300" class="network-grid-line" />
                <line x1="50" y1="400" x2="1160" y2="400" class="network-grid-line" />
                <line x1="50" y1="500" x2="1160" y2="500" class="network-grid-line" />
                <line x1="200" y1="50" x2="200" y2="540" class="network-grid-line" />
                <line x1="400" y1="50" x2="400" y2="540" class="network-grid-line" />
                <line x1="600" y1="50" x2="600" y2="540" class="network-grid-line" />
                <line x1="800" y1="50" x2="800" y2="540" class="network-grid-line" />
                <line x1="1000" y1="50" x2="1000" y2="540" class="network-grid-line" />
              </g>

              <g opacity="0.9">
                <path d="M 350,30 L 360,25 L 380,20 L 400,20 L 415,22 L 425,28 L 430,35 L 420,45 L 405,58 L 390,70 L 375,65 L 362,55 L 350,42 Z" class="network-continent" />
                <path d="M 400,60 L 415,55 L 420,62 L 405,68 Z" class="network-continent" />
                <path d="M 445,100 C 452,95 460,105 455,115 C 448,118 440,110 445,100 Z" class="network-continent" />
                <path d="M 50,150 L 55,140 L 70,120 L 90,100 L 110,85 L 130,75 L 160,70 L 190,65 L 220,62 L 250,55 L 280,48 L 310,42 L 325,40 L 335,50 L 340,65 L 345,80 L 352,95 L 365,110 L 370,125 L 365,140 L 350,150 L 340,165 L 335,178 L 342,190 L 350,205 L 355,220 L 352,235 L 340,245 L 320,248 L 295,248 L 275,246 L 255,248 L 245,260 L 235,275 L 220,285 L 205,288 L 195,280 L 185,265 L 175,250 L 155,250 L 135,245 L 115,235 L 95,220 L 75,200 L 60,180 Z" class="network-continent" />
                <path d="M 245,290 L 260,290 L 280,295 L 305,302 L 320,308 L 335,315 L 350,325 L 362,338 L 372,352 L 378,368 L 375,385 L 368,400 L 355,420 L 340,442 L 325,465 L 310,490 L 295,515 L 282,535 L 272,550 L 265,550 L 260,540 L 255,520 L 250,495 L 245,465 L 240,430 L 236,395 L 233,360 L 235,330 L 240,310 Z" class="network-continent" />
                <path d="M 430,195 L 422,185 L 420,170 L 424,155 L 432,142 L 445,132 L 460,125 L 472,118 L 485,110 L 498,102 L 510,95 L 525,90 L 545,88 L 565,85 L 590,80 L 615,75 L 640,70 L 670,65 L 700,60 L 735,58 L 770,58 L 805,60 L 840,62 L 875,65 L 910,70 L 945,78 L 975,88 L 1000,100 L 1020,115 L 1035,135 L 1042,155 L 1040,175 L 1032,192 L 1020,208 L 1005,220 L 985,228 L 965,232 L 945,230 L 925,222 L 910,215 L 900,225 L 892,240 L 888,258 L 882,275 L 872,288 L 858,298 L 840,305 L 820,312 L 800,322 L 780,332 L 762,340 L 748,335 L 738,342 L 730,355 L 722,342 L 712,335 L 698,340 L 685,332 L 670,322 L 650,312 L 632,305 L 615,298 L 595,292 L 575,290 L 555,290 L 535,292 L 515,290 L 495,282 L 478,270 L 462,255 L 448,238 L 438,218 Z" class="network-continent" />
                <path d="M 1030,150 Q 1045,170 1025,200 Q 1018,180 1030,150 Z" class="network-continent" />
                <path d="M 460,280 L 480,272 L 510,268 L 540,268 L 570,272 L 590,282 L 605,295 L 618,310 L 625,330 L 628,350 L 625,370 L 618,390 L 608,410 L 595,432 L 580,455 L 565,480 L 550,505 L 538,525 L 532,530 L 526,525 L 522,510 L 516,490 L 510,465 L 502,440 L 492,415 L 480,390 L 468,368 L 455,348 L 448,328 L 448,310 L 452,292 Z" class="network-continent" />
                <path d="M 620,430 L 630,420 L 640,440 L 630,465 L 618,455 Z" class="network-continent" />
                <path d="M 890,415 L 910,408 L 935,405 L 960,408 L 980,415 L 995,425 L 1010,438 L 1018,455 L 1015,472 L 1008,490 L 995,505 L 975,515 L 950,518 L 925,515 L 905,505 L 890,490 L 880,470 L 875,450 L 880,430 Z" class="network-continent" />
              </g>

              {%- assign center_x = 730 -%}
              {%- assign center_y = 300 -%}
              {%- assign left_x = "810,850,830,800,770,690,670,700" | split: "," -%}
              {%- assign left_y = "205,250,310,345,200,215,290,350" | split: "," -%}
              {%- assign right_x = "230,150,490,280,460,960,620,950" | split: "," -%}
              {%- assign right_y = "170,120,120,210,165,130,250,450" | split: "," -%}

              {%- assign default_clients = "Crocon,Adda,Adil Quadri,Plix,Kasutam,Mars Exports,Folello,Himalibuti" | split: "," -%}
              {%- assign default_marketplaces = "Walmart,Amazon US,Shopify,eBay US,Etsy,Alibaba,Amazon UAE,eBay AU" | split: "," -%}
              {%- assign default_marketplaces_svg = "walmart,amazon,shopify,ebay,etsy,alibaba,amazon,ebay" | split: "," -%}

              {%- for i in (0..7) -%}
                {%- assign x = left_x[i] | plus: 0 -%}
                {%- assign y = left_y[i] | plus: 0 -%}
                {%- assign line_path = "M " | append: x | append: " " | append: y | append: " L " | append: center_x | append: " " | append: center_y -%}
                {%- assign delay_index = i | modulo: 4 -%}
                <g>
                  <path class="animate-width" d="{{ line_path }}" stroke="url(#paint0_linear_full)" stroke-width="2" stroke-linecap="round" />
                  <path class="signal-line delay-wave-{{ delay_index }}" d="{{ line_path }}" stroke="url(#paint0_linear_full)" stroke-width="3.5" stroke-linecap="round" />
                </g>
              {%- endfor -%}

              {%- for i in (0..7) -%}
                {%- assign x = right_x[i] | plus: 0 -%}
                {%- assign y = right_y[i] | plus: 0 -%}
                {%- assign ctrl_x = center_x | plus: x | divided_by: 2 -%}
                {%- if center_y < y -%}
                  {%- assign ctrl_y = center_y | minus: 60 -%}
                {%- else -%}
                  {%- assign ctrl_y = y | minus: 60 -%}
                {%- endif -%}
                {%- assign line_path = "M " | append: center_x | append: " " | append: center_y | append: " Q " | append: ctrl_x | append: " " | append: ctrl_y | append: " " | append: x | append: " " | append: y -%}
                {%- assign delay_index = i | plus: 2 | modulo: 4 -%}
                <g>
                  <path class="animate-width" d="{{ line_path }}" stroke="url(#paint1_linear_full)" stroke-width="2" stroke-linecap="round" />
                  <path class="signal-line delay-wave-{{ delay_index }}" d="{{ line_path }}" stroke="url(#paint1_linear_full)" stroke-width="3.5" stroke-linecap="round" />
                </g>
              {%- endfor -%}

              <!-- Center node -->
              <g transform="translate({{ center_x }}, {{ center_y }})">
                <g class="network-node center-node">
                  {%- if section.settings.network_center_logo != blank -%}
                    <rect x="-70" y="-55" width="140" height="110" rx="20" fill="#ffffff" stroke="#e8e0d7" stroke-width="2.5" />
                    <image href="{{ section.settings.network_center_logo | image_url: width: 200 }}" x="-55" y="-40" height="80" width="110" preserveAspectRatio="xMidYMid meet" />
                  {%- else -%}
                    <rect x="-65" y="-50" width="130" height="100" rx="20" fill="#26180f" stroke="#fc9f30" stroke-width="2.5" />
                    <text x="0" y="10" text-anchor="middle" fill="#ffffff" font-family="Satoshi, sans-serif" font-weight="900" font-size="34" letter-spacing="-0.04em">W<tspan fill="#fc9f30">.</tspan></text>
                    <text x="0" y="32" text-anchor="middle" fill="#fdfbf8" font-family="Satoshi, sans-serif" font-weight="700" font-size="9" letter-spacing="0.1em" opacity="0.75" class="uppercase">ENGINE</text>
                  {%- endif -%}
                </g>
              </g>

              <!-- Left nodes -->
              {%- for i in (0..7) -%}
                {%- assign x = left_x[i] | plus: 0 -%}
                {%- assign y = left_y[i] | plus: 0 -%}
                {%- assign name = default_clients[i] -%}
                <g transform="translate({{ x }}, {{ y }})">
                  <g class="network-node">
                    <circle r="26" fill="#ffffff" stroke="#e8e0d7" stroke-width="1.5" class="node-bg" />
                    <circle r="16" fill="#fc9f30" fill-opacity="0.1" />
                    <text x="0" y="4" text-anchor="middle" fill="#26180f" font-family="Satoshi, sans-serif" font-weight="800" font-size="12" class="select-none">{{ name | slice: 0, 1 | upcase }}</text>
                    <text x="0" y="44" text-anchor="middle" fill="#190f08" font-size="9" font-weight="800" class="node-label font-outfit uppercase tracking-wider select-none">
                      {{ name }}
                    </text>
                  </g>
                </g>
              {%- endfor -%}

              <!-- Right nodes -->
              {%- for i in (0..7) -%}
                {%- assign x = right_x[i] | plus: 0 -%}
                {%- assign y = right_y[i] | plus: 0 -%}
                {%- assign name = default_marketplaces[i] -%}
                {%- assign svg_name = default_marketplaces_svg[i] -%}
                <g transform="translate({{ x }}, {{ y }})">
                  <g class="network-node">
                    <circle r="26" fill="#ffffff" stroke="#e8e0d7" stroke-width="1.5" class="node-bg" />
                    <foreignObject x="-18" y="-18" width="36" height="36" requiredExtensions="http://www.w3.org/1999/xhtml">
                      <div xmlns="http://www.w3.org/1999/xhtml" class="w-full h-full flex items-center justify-center text-primary">
                        {% render 'walbayzon-platform-svg', platform_name: svg_name %}
                      </div>
                    </foreignObject>
                    <text x="0" y="44" text-anchor="middle" fill="#190f08" font-size="9" font-weight="800" class="node-label font-outfit uppercase tracking-wider select-none">
                      {{ name }}
                    </text>
                  </g>
                </g>
              {%- endfor -%}

              <defs>
                <linearGradient id="paint0_linear_full" x1="0" y1="0" x2="1" y2="1">
                  <stop stop-color="#fc9f30"></stop>
                  <stop offset="1" stop-color="#26180f"></stop>
                </linearGradient>
                <linearGradient id="paint1_linear_full" x1="0" y1="0" x2="1" y2="1">
                  <stop stop-color="#26180f"></stop>
                  <stop offset="1" stop-color="#fc9f30"></stop>
                </linearGradient>
              </defs>
            </svg>
          </div>
        </div>
      </div>
    </section>
  {% endif %}

  <!-- ================= SERVICES ================= -->
