{% comment %}
  Walbayzon All-in-One Landing Page Section
  Compatible with Shopify Theme Editor
{% endcomment %}

<!-- Google Fonts and Tailwind CSS -->
<link rel="preconnect" href="https://api.fontshare.com" />
<link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700,900&f[]=general-sans@400,500,600,700&display=swap" />
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    corePlugins: {
      preflight: false, // Prevents resetting your theme's default settings
    },
    theme: {
      extend: {
        fontFamily: {
          display: ['Satoshi','General Sans','ui-sans-serif','system-ui','sans-serif'],
          sans: ['Satoshi','General Sans','ui-sans-serif','system-ui','sans-serif'],
        },
        colors: {
          background: 'oklch(0.99 0.005 80)',
          foreground: 'oklch(0.18 0.022 55)',
          card: '#ffffff',
          border: 'oklch(0.91 0.015 70)',
          secondary: 'oklch(0.96 0.015 75)',
          muted: { DEFAULT: 'oklch(0.955 0.012 75)', foreground: 'oklch(0.45 0.018 55)' },
          primary: { DEFAULT: 'oklch(0.225 0.028 55)', foreground: 'oklch(0.985 0.008 80)' },
          brand: {
            coffee: 'oklch(0.225 0.028 55)',
            orange: 'oklch(0.78 0.16 65)',
            'orange-soft': 'oklch(0.92 0.07 75)',
            cream: 'oklch(0.985 0.008 80)',
          },
        },
        borderRadius: { '3xl': '1.625rem' },
      }
    }
  }
</script>

<style>
  .wb-landing-wrapper {
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    font-family: 'Satoshi','General Sans',ui-sans-serif,system-ui,sans-serif;
    background: oklch(0.99 0.005 80);
    color: oklch(0.18 0.022 55);
  }
  .wb-landing-wrapper h1,
  .wb-landing-wrapper h2,
  .wb-landing-wrapper h3,
  .wb-landing-wrapper h4 {
    font-family: 'Satoshi','General Sans',sans-serif;
    letter-spacing: -0.02em;
    font-weight: 700;
  }
  .gradient-warm { background: linear-gradient(135deg, oklch(0.98 0.02 75) 0%, oklch(0.94 0.05 70) 100%); }
  .gradient-coffee { background: linear-gradient(135deg, oklch(0.22 0.025 50) 0%, oklch(0.16 0.02 45) 100%); }
  .gradient-orange { background: linear-gradient(135deg, oklch(0.82 0.16 65) 0%, oklch(0.72 0.18 50) 100%); }
  
  .wb-marquee-wrapper {
    display: flex;
    overflow: hidden;
    user-select: none;
    gap: 12px;
  }
  .wb-animate-marquee {
    display: flex;
    gap: 12px;
    animation: wb-marquee-scroll 35s linear infinite;
  }
  @keyframes wb-marquee-scroll {
    from { transform: translateX(0) }
    to { transform: translateX(-50%) }
  }
  .fade-up { animation: fadeUp .8s cubic-bezier(.22,1,.36,1) both; }
  @keyframes fadeUp { from { opacity:0; transform: translateY(16px) } to { opacity:1; transform: translateY(0) } }
</style>

<div class="wb-landing-wrapper min-h-screen bg-background">

  <!-- ================= ANNOUNCEMENT BAR ================= -->
  {% if section.settings.show_announcement %}
    <div class="w-full bg-brand-orange-soft">
      <div class="mx-auto flex max-w-7xl items-center justify-center gap-2 px-3 py-2 text-center text-[11px] font-medium text-foreground sm:gap-3 sm:px-5 sm:text-sm lg:px-8">
        <span class="line-clamp-2 sm:line-clamp-1">{{ section.settings.announcement_text }}</span>
        {% if section.settings.announcement_link != blank %}
          <a href="{{ section.settings.announcement_link }}" class="shrink-0 rounded-full bg-brand-orange px-3 py-1 text-xs font-semibold text-primary shadow-sm transition-transform hover:scale-[1.03] inline-flex">
            {{ section.settings.announcement_link_text }}
          </a>
        {% endif %}
      </div>
    </div>
  {% endif %}

  <!-- ================= HEADER ================= -->
  {% if section.settings.show_header %}
    <header class="w-full border-b border-border/60 bg-background/80 backdrop-blur-xl sticky top-0 z-50">
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 lg:h-20 lg:px-8">
        <a href="#" class="flex items-center gap-2.5">
          <div class="grid h-9 w-9 place-items-center rounded-full bg-primary">
            <span class="font-display text-base font-black text-primary-foreground">W<span class="text-brand-orange">.</span></span>
          </div>
          <span class="font-display text-lg font-bold tracking-tight text-foreground">{{ section.settings.header_logo_text }}</span>
        </a>
        <nav class="hidden items-center gap-1 lg:flex">
          {% for link in linklists[section.settings.header_menu].links %}
            <a href="{{ link.url }}" class="rounded-full px-4 py-2 text-sm font-medium text-foreground/80 hover:bg-secondary hover:text-foreground">
              {{ link.title }}
            </a>
          {% else %}
            <a href="#services" class="rounded-full px-4 py-2 text-sm font-medium text-foreground/80 hover:bg-secondary hover:text-foreground">Services</a>
            <a href="#how" class="rounded-full px-4 py-2 text-sm font-medium text-foreground/80 hover:bg-secondary hover:text-foreground">How We Work</a>
            <a href="#mastercourse" class="rounded-full px-4 py-2 text-sm font-medium text-foreground/80 hover:bg-secondary hover:text-foreground">Mastercourse</a>
          {% endfor %}
        </nav>
        <div class="hidden items-center gap-5 lg:flex">
          {% if section.settings.header_btn1_text != blank %}
            <div class="relative">
              <span aria-hidden class="absolute inset-0 translate-x-1.5 translate-y-1.5 rounded-full bg-foreground"></span>
              <a href="{{ section.settings.header_btn1_url }}" class="relative inline-flex items-center rounded-full border-2 border-foreground bg-background px-5 py-2.5 text-sm font-semibold text-foreground transition-transform duration-150 hover:translate-x-1.5 hover:translate-y-1.5">{{ section.settings.header_btn1_text }}</a>
            </div>
          {% endif %}
          {% if section.settings.header_btn2_text != blank %}
            <div class="relative">
              <span aria-hidden class="absolute inset-0 translate-x-1.5 translate-y-1.5 rounded-full bg-foreground"></span>
              <a href="{{ section.settings.header_btn2_url }}" class="relative inline-flex items-center rounded-full border-2 border-foreground bg-brand-orange px-5 py-2.5 text-sm font-semibold text-foreground transition-transform duration-150 hover:translate-x-1.5 hover:translate-y-1.5">{{ section.settings.header_btn2_text }}</a>
            </div>
          {% endif %}
        </div>
      </div>
    </header>
  {% endif %}

  <!-- ================= HERO ================= -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 gradient-warm"></div>
    <div class="absolute -top-32 left-1/2 -z-10 h-[500px] w-[800px] -translate-x-1/2 rounded-full bg-brand-orange/20 blur-3xl"></div>
    <div class="mx-auto max-w-7xl px-4 pb-20 pt-12 sm:px-5 sm:pb-24 sm:pt-16 lg:px-8 lg:pb-32 lg:pt-24">
      <div class="mx-auto max-w-4xl text-center fade-up">
        {% if section.settings.hero_badge != blank %}
          <div class="inline-flex items-center gap-2 rounded-full border border-border bg-background/60 px-3 py-1.5 text-[11px] font-medium text-foreground/70 backdrop-blur sm:px-4 sm:text-xs">
            <span class="relative flex h-2 w-2"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-orange opacity-75"></span><span class="relative inline-flex h-2 w-2 rounded-full bg-brand-orange"></span></span>
            <span>{{ section.settings.hero_badge }}</span>
          </div>
        {% endif %}
        <h1 class="mt-6 font-display text-[2.5rem] font-bold leading-[1.2] tracking-tight text-balance text-foreground sm:mt-7 sm:text-6xl md:text-7xl lg:text-[6.5rem] lg:leading-[1.25]">
          {{ section.settings.hero_headline }}
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-base text-muted-foreground sm:mt-7 sm:text-lg md:text-xl">{{ section.settings.hero_subheading }}</p>
        <div class="mt-8 flex flex-col items-center justify-center gap-5 sm:mt-9 sm:flex-row">
          {% if section.settings.hero_btn1_text != blank %}
            <div class="relative w-full sm:w-auto">
              <span aria-hidden class="absolute inset-0 translate-x-1.5 translate-y-1.5 rounded-full bg-foreground"></span>
              <a href="{{ section.settings.hero_btn1_url }}" class="relative inline-flex w-full items-center justify-center rounded-full border-2 border-foreground bg-background px-6 py-3 text-base font-semibold text-foreground transition-transform duration-150 hover:translate-x-1.5 hover:translate-y-1.5 sm:w-auto">{{ section.settings.hero_btn1_text }}</a>
            </div>
          {% endif %}
          {% if section.settings.hero_btn2_text != blank %}
            <div class="relative w-full sm:w-auto">
              <span aria-hidden class="absolute inset-0 translate-x-1.5 translate-y-1.5 rounded-full bg-foreground"></span>
              <a href="{{ section.settings.hero_btn2_url }}" class="relative inline-flex w-full items-center justify-center rounded-full border-2 border-foreground bg-brand-orange px-6 py-3 text-base font-semibold text-foreground transition-transform duration-150 hover:translate-x-1.5 hover:translate-y-1.5 sm:w-auto">{{ section.settings.hero_btn2_text }}</a>
            </div>
          {% endif %}
        </div>
        <div class="mt-10 flex flex-col items-center justify-center gap-3 text-sm text-muted-foreground sm:flex-row sm:gap-6">
          <div class="flex items-center gap-1.5 text-brand-orange" id="hero-stars-landing">
            {% for i in (1..5) %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            {% endfor %}
          </div>
          <span class="text-xs sm:text-sm">{{ section.settings.hero_rating_desc }}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= MARQUEE ================= -->
  <section class="border-y border-border bg-card py-12">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <p class="mb-8 text-center text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground">{{ section.settings.marquee_title }}</p>
      <div class="relative overflow-hidden">
        <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-white to-transparent"></div>
        <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-white to-transparent"></div>
        <div class="wb-marquee-wrapper">
          <div class="wb-animate-marquee">
            {% for block in section.blocks %}
              {% if block.type == 'platform' %}
                <div class="rounded-2xl border border-border bg-background px-7 py-4 font-display text-xl font-bold tracking-tight text-foreground/80 shrink-0">{{ block.settings.title }}</div>
              {% endif %}
            {% endfor %}
            <!-- Duplicate for infinite scrolling -->
            {% for block in section.blocks %}
              {% if block.type == 'platform' %}
                <div class="rounded-2xl border border-border bg-background px-7 py-4 font-display text-xl font-bold tracking-tight text-foreground/80 shrink-0" aria-hidden="true">{{ block.settings.title }}</div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= SERVICES ================= -->
  <section id="services" class="relative py-16 sm:py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-5 lg:px-8">
      <div class="grid items-end gap-6 lg:grid-cols-[1fr_auto] lg:gap-8">
        <div>
          <p class="text-xs font-medium uppercase tracking-[0.2em] text-brand-orange sm:text-sm">{{ section.settings.services_sub }}</p>
          <h2 class="mt-4 max-w-3xl font-display text-3xl font-bold leading-[1.1] tracking-tight text-balance sm:text-4xl md:text-5xl lg:text-6xl text-foreground">{{ section.settings.services_title }}</h2>
        </div>
      </div>
      <div class="mt-12 grid gap-px overflow-hidden rounded-3xl border border-border bg-border sm:mt-16 sm:grid-cols-2 lg:grid-cols-3">
        {% for block in section.blocks %}
          {% if block.type == 'service' %}
            <div class="group relative bg-card p-6 transition-colors hover:bg-secondary sm:p-8">
              <div class="flex items-start justify-between">
                <div class="grid h-12 w-12 place-items-center rounded-2xl bg-primary text-primary-foreground group-hover:bg-brand-orange group-hover:text-primary">
                  <span class="text-xl">{{ block.settings.emoji }}</span>
                </div>
                <span class="font-display text-xs font-bold tracking-wider text-muted-foreground">{{ block.settings.tag }}</span>
              </div>
              <h3 class="mt-6 font-display text-xl font-bold tracking-tight sm:mt-8 sm:text-2xl text-foreground">{{ block.settings.title }}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{{ block.settings.description }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- ================= STATS ================= -->
  <section class="px-4 sm:px-5 lg:px-8">
    <div class="mx-auto max-w-7xl overflow-hidden rounded-[1.5rem] gradient-coffee p-6 text-primary-foreground sm:rounded-[2rem] sm:p-10 lg:p-16">
      <div class="grid gap-8 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
        <div>
          <p class="text-xs font-medium uppercase tracking-[0.2em] text-brand-orange sm:text-sm">{{ section.settings.stats_sub }}</p>
          <h2 class="mt-4 font-display text-3xl font-bold leading-[1.05] tracking-tight text-balance sm:text-4xl md:text-5xl">{{ section.settings.stats_title }}</h2>
          <p class="mt-5 max-w-md text-sm text-primary-foreground/70 sm:text-base">{{ section.settings.stats_desc }}</p>
        </div>
        <div class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl bg-primary-foreground/10">
          {% for block in section.blocks %}
            {% if block.type == 'stat' %}
              <div class="bg-primary p-4 sm:p-6 lg:p-8">
                <div class="font-display text-2xl font-bold tracking-tight text-brand-orange sm:text-4xl lg:text-5xl">{{ block.settings.value }}</div>
                <div class="mt-2 text-xs text-primary-foreground/70 sm:text-sm">{{ block.settings.label }}</div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </section>

  <!-- ================= PROCESS ================= -->
  <section id="how" class="py-16 sm:py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-5 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-xs font-medium uppercase tracking-[0.2em] text-brand-orange sm:text-sm">{{ section.settings.process_sub }}</p>
        <h2 class="mt-4 font-display text-3xl font-bold leading-[1.1] tracking-tight text-balance sm:text-4xl md:text-5xl lg:text-6xl text-foreground">{{ section.settings.process_title }}</h2>
      </div>
      <div class="mt-12 grid gap-5 sm:mt-16 sm:grid-cols-2 lg:grid-cols-4">
        {% for block in section.blocks %}
          {% if block.type == 'step' %}
            <div class="relative rounded-3xl border border-border bg-card p-6 transition-all hover:-translate-y-1 hover:border-brand-orange hover:shadow-2xl sm:p-7">
              <div class="flex items-center justify-between">
                <span class="font-display text-4xl font-black text-brand-orange-soft sm:text-5xl">{{ block.settings.number }}</span>
                {% unless forloop.last %}
                  <span class="rotate-45 text-muted-foreground">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
                  </span>
                {% endunless %}
              </div>
              <h3 class="mt-5 font-display text-xl font-bold tracking-tight text-foreground">{{ block.settings.title }}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{{ block.settings.desc }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- ================= TESTIMONIALS ================= -->
  <section class="bg-secondary/60 py-16 sm:py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-5 lg:px-8">
      <div>
        <p class="text-xs font-medium uppercase tracking-[0.2em] text-brand-orange sm:text-sm">{{ section.settings.testimonials_sub }}</p>
        <h2 class="mt-4 max-w-2xl font-display text-3xl font-bold leading-[1.1] tracking-tight text-balance sm:text-4xl md:text-5xl lg:text-6xl text-foreground">{{ section.settings.testimonials_title }}</h2>
      </div>
      <div class="mt-12 grid gap-5 sm:mt-16 md:grid-cols-2 lg:grid-cols-3">
        {% for block in section.blocks %}
          {% if block.type == 'testimonial' %}
            <figure class="flex flex-col justify-between rounded-3xl border border-border bg-card p-6 sm:p-8">
              <div>
                <span class="text-brand-orange">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="28" height="28"><path d="M3 21c3 0 7-1 7-8V5H3v9h4"/><path d="M14 21c3 0 7-1 7-8V5h-7v9h4"/></svg>
                </span>
                <blockquote class="mt-5 text-base leading-relaxed text-foreground text-balance sm:text-lg">"{{ block.settings.quote }}"</blockquote>
              </div>
              <figcaption class="mt-8 flex items-center justify-between border-t border-border pt-5">
                <div>
                  <div class="font-display text-sm font-bold text-foreground">{{ block.settings.author }}</div>
                  <div class="text-xs text-muted-foreground">{{ block.settings.role }}</div>
                </div>
                <div class="flex gap-0.5 text-brand-orange">
                  {% for i in (1..block.settings.stars) %}
                    <span class="inline-flex"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></span>
                  {% endfor %}
                </div>
              </figcaption>
            </figure>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- ================= MASTERCOURSE ================= -->
  <section id="mastercourse" class="px-4 pb-16 sm:px-5 sm:pb-24 lg:px-8 lg:pb-32">
    <div class="mx-auto grid max-w-7xl overflow-hidden rounded-[1.5rem] border border-border bg-card sm:rounded-[2rem] lg:grid-cols-[1.1fr_1fr]">
      <div class="p-6 sm:p-10 lg:p-16">
        <p class="text-xs font-medium uppercase tracking-[0.2em] text-brand-orange sm:text-sm">{{ section.settings.course_sub }}</p>
        <h2 class="mt-4 font-display text-3xl font-bold leading-[1.1] tracking-tight text-balance sm:text-4xl md:text-5xl text-foreground">{{ section.settings.course_title }}</h2>
        <p class="mt-5 max-w-md text-sm text-muted-foreground sm:text-base">{{ section.settings.course_desc }}</p>
        <ul class="mt-8 space-y-3">
          {% if section.settings.course_perk1 != blank %}
            <li class="flex items-start gap-3 text-sm text-foreground">
              <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-brand-orange text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" width="12" height="12"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              {{ section.settings.course_perk1 }}
            </li>
          {% endif %}
          {% if section.settings.course_perk2 != blank %}
            <li class="flex items-start gap-3 text-sm text-foreground">
              <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-brand-orange text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" width="12" height="12"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              {{ section.settings.course_perk2 }}
            </li>
          {% endif %}
          {% if section.settings.course_perk3 != blank %}
            <li class="flex items-start gap-3 text-sm text-foreground">
              <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-brand-orange text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" width="12" height="12"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              {{ section.settings.course_perk3 }}
            </li>
          {% endif %}
          {% if section.settings.course_perk4 != blank %}
            <li class="flex items-start gap-3 text-sm text-foreground">
              <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-brand-orange text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" width="12" height="12"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              {{ section.settings.course_perk4 }}
            </li>
          {% endif %}
        </ul>
        {% if section.settings.course_btn_text != blank %}
          <a href="{{ section.settings.course_btn_url }}" class="mt-8 inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3.5 text-sm font-semibold text-primary-foreground transition-all hover:shadow-xl sm:mt-10">
            {{ section.settings.course_btn_text }}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
          </a>
        {% endif %}
      </div>
      <div class="relative gradient-orange p-6 sm:p-10 lg:p-16">
        <div class="absolute right-4 top-4 rounded-full bg-primary px-3 py-1 text-[11px] font-semibold text-primary-foreground sm:right-6 sm:top-6 sm:text-xs">{{ section.settings.course_card_badge }}</div>
        <div class="flex h-full flex-col justify-between gap-8 sm:gap-10">
          <div>
            <div class="font-display text-6xl font-black leading-none text-primary sm:text-7xl lg:text-8xl">{{ section.settings.course_card_duration }}<span class="text-primary/40">{{ section.settings.course_card_duration_unit }}</span></div>
            <p class="mt-4 max-w-xs text-sm font-medium text-primary/80 sm:text-base">{{ section.settings.course_card_duration_lbl }}</p>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="rounded-2xl bg-primary/10 p-4 backdrop-blur sm:p-5">
              <div class="font-display text-xl font-bold text-primary sm:text-2xl">{{ section.settings.course_stat1_val }}</div>
              <div class="text-xs text-primary/70">{{ section.settings.course_stat1_lbl }}</div>
