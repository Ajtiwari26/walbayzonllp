                  {% endfor %}
                </ul>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <div class="mt-16 flex flex-col items-start justify-between gap-4 border-t border-primary-foreground/10 pt-8 sm:flex-row sm:items-center">
          <p class="text-xs text-primary-foreground/50">&copy; {{ "now" | date: "%Y" }} {{ section.settings.footer_logo_text }}. Crafted with care.</p>
        </div>
      </div>
    </footer>
  {% endif %}

</div>

