{% comment %}
  Walbayzon Sticky Announcement Bar Section
  Compatible with Shopify Theme Editor
{% endcomment %}

<!-- Google Fonts and Tailwind CSS -->
<link rel="preconnect" href="https://api.fontshare.com" />
<link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700,900&f[]=general-sans@400,500,600,700&display=swap" />
<script src="https://cdn.tailwindcss.com"></script>
<script>
  if (typeof tailwind !== 'undefined') {
    tailwind.config = {
      corePlugins: {
        preflight: false, // Prevents resetting your theme's default settings
      },
      theme: {
        extend: {
          fontFamily: {
            display: ['Satoshi','General Sans','ui-sans-serif','system-ui','sans-serif'],
            sans: ['Satoshi','General Sans','ui-sans-serif','system-ui','sans-serif'],
          },
          colors: {
            background: 'oklch(0.99 0.005 80)',
            foreground: 'oklch(0.18 0.022 55)',
            card: '#ffffff',
            border: 'oklch(0.91 0.015 70)',
            secondary: 'oklch(0.96 0.015 75)',
            muted: { DEFAULT: 'oklch(0.955 0.012 75)', foreground: 'oklch(0.45 0.018 55)' },
            primary: { DEFAULT: 'oklch(0.225 0.028 55)', foreground: 'oklch(0.985 0.008 80)' },
            brand: {
              coffee: 'oklch(0.225 0.028 55)',
              orange: 'oklch(0.78 0.16 65)',
              'orange-soft': 'oklch(0.92 0.07 75)',
              cream: 'oklch(0.985 0.008 80)',
            },
          },
          borderRadius: { '3xl': '1.625rem' },
        }
      }
    };
  }
</script>


<div class="walbayzon-announcement w-full" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="mx-auto flex max-w-7xl items-center justify-center gap-2 px-3 py-2 text-center text-[11px] font-medium sm:gap-3 sm:px-5 sm:text-sm lg:px-8">
    <span class="line-clamp-2 sm:line-clamp-1">{{ section.settings.text }}</span>
    {% if section.settings.link_url != blank %}
      <a href="{{ section.settings.link_url }}" 
         class="shrink-0 rounded-full px-3 py-1 text-xs font-semibold shadow-sm transition-transform hover:scale-[1.03] inline-flex"
         style="background-color: {{ section.settings.btn_bg }}; color: {{ section.settings.btn_text }};">
        {{ section.settings.link_label }}
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Walbayzon Announcement",
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Announcement Text",
      "default": "🚀 New: Walbayzon now scales D2C brands on Amazon US, UAE & KSA — with AI-powered listing & ads automation."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link Label",
      "default": "See What's New"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fde8df"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1d1d1b"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button Background",
      "default": "#e77a3d"
    },
    {
      "type": "color",
      "id": "btn_text",
      "label": "Button Text",
      "default": "#1d1d1b"
    }
  ],
  "presets": [
    {
      "name": "Walbayzon Announcement"
    }
  ]
}
{% endschema %}
