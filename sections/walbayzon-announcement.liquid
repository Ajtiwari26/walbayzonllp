{% comment %}
  Walbayzon Sticky Announcement Bar Section
  Compatible with Shopify Theme Editor
{% endcomment %}

<div class="walbayzon-announcement w-full" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="mx-auto flex max-w-7xl items-center justify-center gap-2 px-3 py-2 text-center text-[11px] font-medium sm:gap-3 sm:px-5 sm:text-sm lg:px-8">
    <span class="line-clamp-2 sm:line-clamp-1">{{ section.settings.text }}</span>
    {% if section.settings.link_url != blank %}
      <a href="{{ section.settings.link_url }}" 
         class="shrink-0 rounded-full px-3 py-1 text-xs font-semibold shadow-sm transition-transform hover:scale-[1.03] inline-flex"
         style="background-color: {{ section.settings.btn_bg }}; color: {{ section.settings.btn_text }};">
         {{ section.settings.link_label }}
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Walbayzon Announcement",
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Announcement Text",
      "default": "🚀 New: Walbayzon now scales D2C brands on Amazon US, UAE & KSA — with AI-powered listing & ads automation."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link Label",
      "default": "See What's New"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f5e0d0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1d1d1b"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button Background",
      "default": "#e77a3d"
    },
    {
      "type": "color",
      "id": "btn_text",
      "label": "Button Text",
      "default": "#1d1d1b"
    }
  ],
  "presets": [
    {
      "name": "Walbayzon Announcement"
    }
  ]
}
{% endschema %}
