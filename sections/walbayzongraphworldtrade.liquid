            <!-- Canada & USA mainland -->
            <path d="M 95,72 L 110,65 L 130,60 L 155,55 L 180,50 L 210,48 L 240,50 L 268,55 L 290,58 L 305,55 L 320,50 L 332,48 L 340,55 L 338,68 L 332,78 L 328,90 L 322,100 L 315,108 L 308,115 L 295,122 L 280,128 L 268,135 L 258,142 L 250,152 L 242,162 L 235,172 L 228,178 L 218,185 L 210,195 L 205,205 L 198,212 L 192,218 L 185,225 L 178,232 L 170,238 L 162,240 L 150,242 L 138,238 L 125,230 L 115,220 L 105,208 L 95,198 L 88,188 L 80,175 L 72,162 L 68,148 L 65,135 L 62,122 L 65,108 L 70,95 L 78,82 Z" class="trade-continent" />
