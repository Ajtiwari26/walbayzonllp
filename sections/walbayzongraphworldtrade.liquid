            <path d="M 425,168 L 432,162 L 442,158 L 452,162 L 458,170 L 455,180 L 448,188 L 438,192 L 428,190 L 422,182 L 422,175 Z" class="trade-continent" />

            <!-- ======= AFRICA ======= -->
