{% comment %}
  Walbayzon Interactive Animated World Trade Logistics Map Section
  Compatible with Shopify Theme Editor
{% endcomment %}

<section class="py-20 md:py-24 relative overflow-hidden" style="background: {{ section.settings.bg_gradient }};">
  <div class="max-w-7xl mx-auto px-5">
    
    <!-- Centered Heading & Subheading -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      {% if section.settings.sub_title != blank %}
        <span class="text-brand-orange font-bold text-[13px] uppercase tracking-wider bg-brand-orange/10 px-3 py-1 rounded-full">
          {{ section.settings.sub_title }}
        </span>
      {% endif %}
      
      <h2 class="font-display text-[32px] sm:text-[42px] font-extrabold text-charcoal tracking-tight mt-4 leading-tight">
        {{ section.settings.title }}
      </h2>
      
      {% if section.settings.description != blank %}
        <p class="text-neutral-500 mt-4 text-sm sm:text-base max-w-[650px] mx-auto">
          {{ section.settings.description }}
        </p>
      {% endif %}
    </div>

    <!-- Liquid Block Filtering & JSON Generation -->
    {%- assign brand_blocks = section.blocks | where: "type", "brand" -%}
    {%- assign country_blocks = section.blocks | where: "type", "country" -%}

    {%- capture brands_json -%}
    [
      {%- if brand_blocks.size > 0 -%}
        {%- for block in brand_blocks -%}
          {
            "name": {{ block.settings.title | json }},
            "logo": {% if block.settings.logo != blank %}{{ block.settings.logo | image_url: width: 100 | json }}{% else %}null{% endif %}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      {%- else -%}
        {%- assign default_brands = "Crocon,Adda,Adil Quadri,Plix,Kasutam,Mars Exports,Folello,Himalibuti" | split: "," -%}
        {%- for d_brand in default_brands -%}
          {
            "name": {{ d_brand | json }},
            "logo": null
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      {%- endif -%}
    ]
    {%- endcapture -%}

    {%- capture countries_json -%}
    [
      {%- if country_blocks.size > 0 -%}
        {%- for block in country_blocks -%}
          {
            "name": {{ block.settings.title | json }},
            "flag": {{ block.settings.flag | json }},
            "x": {{ block.settings.map_x | plus: 0 }},
            "y": {{ block.settings.map_y | plus: 0 }},
            "brands": [
              {%- assign brand_names = block.settings.brands | split: "," -%}
              {%- for b_name in brand_names -%}
                {{ b_name | strip | json }}{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ]
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      {%- else -%}
        {
          "name": "United States",
          "flag": "🇺🇸",
          "x": 215,
          "y": 267,
          "brands": ["Crocon", "Plix", "Folello", "Adda"]
        },
        {
          "name": "United Kingdom",
          "flag": "🇬🇧",
          "x": 495,
          "y": 173,
          "brands": ["Adil Quadri", "Kasutam", "Himalibuti", "Crocon"]
        },
        {
          "name": "Germany",
          "flag": "🇩🇪",
          "x": 540,
          "y": 195,
          "brands": ["Kasutam", "Folello", "Mars Exports", "Plix"]
        },
        {
          "name": "United Arab Emirates",
          "flag": "🇦🇪",
          "x": 664,
          "y": 311,
          "brands": ["Adda", "Mars Exports", "Himalibuti", "Adil Quadri"]
        },
        {
          "name": "Saudi Arabia",
          "flag": "🇸🇦",
          "x": 643,
          "y": 310,
          "brands": ["Adda", "Adil Quadri", "Mars Exports", "Kasutam"]
        },
        {
          "name": "Australia",
          "flag": "🇦🇺",
          "x": 940,
          "y": 468,
          "brands": ["Crocon", "Plix", "Folello", "Himalibuti"]
        },
        {
          "name": "Canada",
          "flag": "🇨🇦",
          "x": 195,
          "y": 174,
          "brands": ["Mars Exports", "Himalibuti", "Crocon", "Plix"]
        },
        {
          "name": "Japan",
          "flag": "🇯🇵",
          "x": 940,
          "y": 246,
          "brands": ["Plix", "Folello", "Adda", "Kasutam"]
        }
      {%- endif -%}
    ]
    {%- endcapture -%}

    <!-- Map Wrapper Container -->
    <div class="flex items-center justify-center overflow-x-auto w-full pb-8">
      <div id="walbayzon-trade-map-container" 
           class="min-w-[1000px] w-full max-w-[1211px] h-auto overflow-hidden relative"
           data-brands='{{ brands_json }}'
           data-countries='{{ countries_json }}'>
        
        <!-- SVG Map Layer -->
        <svg width="1211" height="590" viewBox="0 0 1211 590" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto select-none">
          
          <!-- Latitude/Longitude Grid Lines -->
          <g opacity="0.3">
            <!-- Latitudes -->
            <line x1="50" y1="100" x2="1160" y2="100" class="trade-grid-line" />
            <line x1="50" y1="200" x2="1160" y2="200" class="trade-grid-line" />
            <line x1="50" y1="300" x2="1160" y2="300" class="trade-grid-line" />
            <line x1="50" y1="400" x2="1160" y2="400" class="trade-grid-line" />
            <line x1="50" y1="500" x2="1160" y2="500" class="trade-grid-line" />

            <line x1="200" y1="50" x2="200" y2="540" class="trade-grid-line" />
            <line x1="400" y1="50" x2="400" y2="540" class="trade-grid-line" />
            <line x1="600" y1="50" x2="600" y2="540" class="trade-grid-line" />
            <line x1="800" y1="50" x2="800" y2="540" class="trade-grid-line" />
            <line x1="1000" y1="50" x2="1000" y2="540" class="trade-grid-line" />
          </g>

          <!-- World Map Continents Background (High Quality Vector SVG) -->
          <g class="trade-map-continents">
            <image href="{{ 'worldmap.svg' | asset_url }}" x="0" y="0" width="1211" height="590" preserveAspectRatio="none" />
          </g>

          <!-- Origin & Destination Routes (Dotted curved paths and signal lines from India) -->
          <g id="trade-routes-layer"></g>

          <!-- Origin Hub (India) -->
          <g transform="translate(738, 328)">
            <!-- Static Elegant Outer Rings -->
            <circle cx="0" cy="0" r="16" fill="#fc9f30" opacity="0.15" />
            <circle cx="0" cy="0" r="10" fill="#fc9f30" opacity="0.3" />
            <!-- Main Origin Dot -->
            <circle cx="0" cy="0" r="6" fill="#fc9f30" stroke="#26180f" stroke-width="1.5" />
            <!-- Custom Styled Label -->
            <g transform="translate(0, -18)">
              <rect x="-35" y="-10" width="70" height="20" rx="10" fill="#26180f" stroke="#fc9f30" stroke-width="1" />
              <text x="0" y="4" text-anchor="middle" fill="#ffffff" font-family="Satoshi, sans-serif" font-weight="900" font-size="11" letter-spacing="0.05em">INDIA</text>
            </g>
          </g>

          <!-- Destination Dots Layer (Drawn dynamically by JS) -->
          <g id="trade-destinations-layer"></g>

          <!-- Active Brand Logo / Initials Flashing Layer (Drawn dynamically by JS) -->
          <g id="trade-flashing-layer"></g>

          <!-- Theme Gradients -->
          <defs>
            <linearGradient id="paint0_linear" x1="0" y1="0" x2="1" y2="1">
              <stop stop-color="#fc9f30"></stop>
              <stop offset="1" stop-color="#26180f"></stop>
            </linearGradient>
            <linearGradient id="paint1_linear" x1="0" y1="0" x2="1" y2="1">
              <stop stop-color="#26180f"></stop>
              <stop offset="1" stop-color="#fc9f30"></stop>
            </linearGradient>
          </defs>
        </svg>

        <!-- Tooltips Layer (HTML Overlay) -->
        <div id="trade-tooltips-container" class="absolute inset-0 pointer-events-none"></div>

      </div>
    </div>

    <!-- Interactive Hint Legend -->
    <div class="text-center mt-6 select-none animate-pulse">
      <p class="text-neutral-400 text-xs sm:text-sm font-medium tracking-wide flex items-center justify-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-brand-orange">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.042 21.672 13.684 16.6m0 0-2.51 2.225.569-9.47 5.227 7.917-3.286-.672ZM12 2.25V4.5m5.303.197-1.591 1.591M21.75 12h-2.25m-.197 5.303-1.591-1.591M12 19.5v2.25m-5.303-.197 1.591-1.591M2.25 12h2.25m-.197-5.303 1.591 1.591" />
        </svg>
        Hover on any export destination to discover the brands we deliver
      </p>
    </div>

  </div>
</section>

<style>
  /* Coordinate Grid Lines */
  .trade-grid-line {
    stroke: #26180f;
    stroke-width: 1.2;
    stroke-dasharray: 4 8;
    stroke-opacity: 0.08;
  }

  /* Continent outlines and fill */
  .trade-continent {
    fill: #fdfbf8;
    stroke: #26180f;
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-opacity: 0.7;
    transition: fill 0.3s ease, stroke-opacity 0.3s ease;
  }

  /* Route Arc Paths */
  .route-arc-path {
    stroke: #fc9f30;
    stroke-width: 1.5;
    stroke-opacity: 0.16;
    fill: none;
    transition: stroke-opacity 0.3s ease, stroke-width 0.3s ease;
  }
  .route-arc-path.active {
    stroke-opacity: 0.35;
    stroke-width: 2.5;
  }

  /* Signal Line (Glowing dash moving along path) */
  @keyframes pulseFlow {
    0% { stroke-dashoffset: 320px; }
    100% { stroke-dashoffset: 0; }
  }
  .signal-line {
    stroke-dasharray: 45 135;
    stroke-dashoffset: 320px;
    stroke-opacity: 0.88;
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke: url(#paint0_linear);
    fill: none;
    pointer-events: none;
    animation: 3s linear infinite pulseFlow;
  }

  /* Interactive Destinations styling */
  .dest-interactive-group {
    cursor: pointer;
  }
  .dest-interactive-group:hover .dest-dot-core {
    fill: #26180f;
    stroke: #fc9f30;
    stroke-width: 2;
  }

  /* Brand Reveal animations inside SVG */
  @keyframes brandRevealIn {
    0% { transform: scale(0); opacity: 0; }
    15% { transform: scale(1.3); opacity: 1; }
    25% { transform: scale(1); opacity: 1; }
    80% { transform: scale(1); opacity: 1; }
    100% { transform: scale(0); opacity: 0; }
  }
  .brand-flash-reveal {
    transform-origin: 0px 0px;
    animation: brandRevealIn 2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* Glassmorphism Tooltip card overlay (Open-Box version) */
  .trade-map-tooltip {
    position: absolute;
    z-index: 100;
    width: 120px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    opacity: 0;
    pointer-events: none;
    transform: translateY(15px) scale(0.95);
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .trade-map-tooltip.visible {
    opacity: 1;
    pointer-events: none;
    transform: translateY(0) scale(1);
  }

  .tooltip-header {
    position: absolute;
    top: -65px;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    pointer-events: none;
    z-index: 20;
  }

  .tooltip-cargo {
    position: absolute;
    top: 0;
    left: 0;
    width: 80px;
    height: 80px;
    pointer-events: none;
    z-index: 10;
  }

  .cargo-item {
    position: absolute;
    left: 24px; /* (80px wrapper width - 32px item width) / 2 = 24px */
    bottom: 35px; /* Sits right at the box top opening */
    width: 32px;
    height: 32px;
    opacity: 0;
    transform: translate(0, 15px) scale(0) rotate(0deg);
    transition: opacity 0.45s cubic-bezier(0.175, 0.885, 0.32, 1.2), transform 0.45s cubic-bezier(0.175, 0.885, 0.32, 1.2);
    transition-delay: var(--delay, 0s);
  }

  .trade-map-tooltip.visible .cargo-item {
    opacity: 1;
    transform: translate(var(--tx, 0px), var(--ty, 0px)) scale(var(--s, 1)) rotate(var(--r, 0deg));
  }

  .cargo-inner-box {
    width: 100%;
    height: 100%;
    background: #ebd5b3; /* Kraft cardboard color */
    border: 1.5px solid #26180f;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    box-shadow: 0 3px 6px rgba(38, 24, 15, 0.15), inset 0 1px 2px rgba(255,255,255,0.4);
  }

  .cargo-shipping-label {
    width: 76%;
    height: 76%;
    background: #ffffff;
    border: 1px solid #26180f;
    border-radius: 2px;
    padding: 1px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 1px 2px rgba(0,0,0,0.06);
  }

  .cargo-brand-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* SVG Box Lids rotation animations */
  .box-lid-left {
    transform-origin: 15px 42px;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .box-lid-right {
    transform-origin: 65px 42px;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .trade-map-tooltip.visible .box-lid-left {
    transform: rotate(-35deg) translate(-3px, -3px);
  }
  .trade-map-tooltip.visible .box-lid-right {
    transform: rotate(35deg) translate(3px, -3px);
  }

  .tooltip-box-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 80px;
    width: 80px;
  }
</style>

<script>
  (function() {
    const initTradeMap = () => {
      const container = document.getElementById('walbayzon-trade-map-container');
      if (!container) return;

      const brandsData = JSON.parse(container.getAttribute('data-brands') || '[]');
      const countriesData = JSON.parse(container.getAttribute('data-countries') || '[]');

      const routesLayer = document.getElementById('trade-routes-layer');
      const destinationsLayer = document.getElementById('trade-destinations-layer');
      const flashingLayer = document.getElementById('trade-flashing-layer');
      const tooltipsContainer = document.getElementById('trade-tooltips-container');

      if (!routesLayer || !destinationsLayer || !flashingLayer || !tooltipsContainer) return;

      // Clear layers to handle Theme Editor reloads
      routesLayer.innerHTML = '';
      destinationsLayer.innerHTML = '';
      flashingLayer.innerHTML = '';
      tooltipsContainer.innerHTML = '';

      const origin = { x: 738, y: 328 };

      // SVG code for platforms from platforms dominated section
      const platformSVGs = {
        'amazon': `<svg style="width: 100%; height: 100%; fill: #000000; display: block;" viewBox="0 2 24 20" xmlns="http://www.w3.org/2000/svg"><title>Amazon</title><path d="M.045 18.02c.072-.116.187-.124.348-.022 3.636 2.11 7.594 3.166 11.87 3.166 2.852 0 5.668-.533 8.447-1.595l.315-.14c.138-.06.234-.1.293-.13.226-.088.39-.046.525.13.12.174.09.336-.12.48-.256.19-.6.41-1.006.654-1.244.743-2.64 1.316-4.185 1.726a17.617 17.617 0 01-10.951-.577 17.88 17.88 0 01-5.43-3.35c-.1-.074-.151-.15-.151-.22 0-.047.021-.09.051-.13zm6.565-6.218c0-1.005.247-1.863.743-2.577.495-.71 1.17-1.25 2.04-1.615.796-.335 1.756-.575 2.912-.72.39-.046 1.033-.103 1.92-.174v-.37c0-.93-.105-1.558-.3-1.875-.302-.43-.78-.65-1.44-.65h-.182c-.48.046-.896.196-1.246.46-.35.27-.575.63-.675 1.096-.06.3-.206.465-.435.51l-2.52-.315c-.248-.06-.372-.18-.372-.39 0-.046.007-.09.022-.15.247-1.29.855-2.25 1.82-2.88.976-.616 2.1-.975 3.39-1.05h.54c1.65 0 2.957.434 3.888 1.29.135.15.27.3.405.48.12.165.224.314.283.45.075.134.15.33.195.57.06.254.105.42.135.51.03.104.062.3.076.615.01.313.02.493.02.553v5.28c0 .376.06.72.165 1.036.105.313.21.54.315.674l.51.674c.09.136.136.256.136.36 0 .12-.06.226-.18.314-1.2 1.05-1.86 1.62-1.963 1.71-.165.135-.375.15-.63.045a6.062 6.062 0 01-.526-.496l-.31-.347a9.391 9.391 0 01-.317-.42l-.3-.435c-.81.886-1.603 1.44-2.4 1.665-.494.15-1.093.227-1.83.227-1.11 0-2.04-.343-2.76-1.034-.72-.69-1.08-1.665-1.08-2.94l-.05-.076zm3.753-.438c0 .566.14 1.02.425 1.364.285.34.675.512 1.155.512.045 0 .106-.007.195-.02.09-.016.134-.023.166-.023.614-.16 1.08-.553 1.424-1.178.165-.28.285-.58.36-.91.09-.32.12-.59.135-.8.015-.195.015-.54.015-1.005v-.54c-.84 0-1.484.06-1.92.18-1.275.36-1.92 1.17-1.92 2.43l-.035-.02zm9.162 7.027c.03-.06.075-.11.132-.17.362-.243.714-.41 1.05-.5a8.094 8.094 0 011.612-.24c.14-.012.28 0 .41.03.65.06 1.05.168 1.172.33.063.09.099.228.099.39v.15c0 .51-.149 1.11-.424 1.8-.278.69-.664 1.248-1.156 1.68-.073.06-.14.09-.197.09-.03 0-.06 0-.09-.012-.09-.044-.107-.12-.064-.24.54-1.26.806-2.143.806-2.64 0-.15-.03-.27-.087-.344-.145-.166-.55-.257-1.224-.257-.243 0-.533.016-.87.046-.363.045-.7.09-1 .135-.09 0-.148-.014-.18-.044-.03-.03-.036-.047-.02-.077 0-.017.006-.03.02-.063v-.06z"/></svg>`,
        'flipkart': `<svg style="width: 100%; height: 100%; fill: #000000; display: block;" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><title>Flipkart</title><path d="M3.833 1.333a.993.993 0 0 0-.333.061V1c0-.551.449-1 1-1h14.667c.551 0 1 .449 1 1v.333H3.833zm17.334 2.334H2.833c-.551 0-1 .449-1 1V23c0 .551.449 1 1 1h7.3l1.098-5.645h-2.24c-.051 0-5.158-.241-5.158-.241l4.639-.327-.078-.366-1.978-.285 1.882-.158-.124-.449-3.075-.467s3.341-.373 3.392-.373h3.232l.247-1.331c.289-1.616.945-2.807 1.973-3.693 1.033-.892 2.344-1.332 3.937-1.332.643 0 1.053.151 1.231.463.118.186.201.516.279.859.074.352.14.671.095.903-.057.345-.461.465-1.197.465h-.253c-1.327 0-2.134.763-2.405 2.31l-.243 1.355h1.54c.574 0 .781.402.622 1.306-.17.941-.539 1.36-1.111 1.36H14.9L13.804 24h7.362c.551 0 1-.449 1-1V4.667a1 1 0 0 0-.999-1zM20.5 2.333A.334.334 0 0 0 20.167 2H3.833a.334.334 0 0 0-.333.333V3h17v-.667z"/></svg>`,
        'meesho': `<svg style="width: 100%; height: 100%; color: #000000; display: block;" viewBox="0 0 120 40" xmlns="http://www.w3.org/2000/svg"><text x="50%" y="30" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-weight="900" font-size="34" fill="currentColor" letter-spacing="-0.03em">meesho</text></svg>`,
        'jiomart': `<svg style="width: 100%; height: 100%; fill: #000000; display: block;" viewBox="8 6 16 19" xmlns="http://www.w3.org/2000/svg"><path d="M23.3894 11.65C23.2016 11.4446 22.9729 11.2807 22.718 11.1688C22.4632 11.0569 22.1878 10.9994 21.9094 11H19.9994V10C19.9994 8.93913 19.578 7.92172 18.8279 7.17157C18.0777 6.42143 17.0603 6 15.9994 6C14.9386 6 13.9212 6.42143 13.171 7.17157C12.4209 7.92172 11.9994 8.93913 11.9994 10V11H10.0894C9.8111 10.9994 9.5357 11.0569 9.28085 11.1688C9.026 11.2807 8.79733 11.4446 8.60945 11.65C8.4249 11.8553 8.2837 12.0957 8.19435 12.3569C8.10499 12.6181 8.06931 12.8947 8.08944 13.17L8.84945 22.25C8.9123 23.0016 9.2559 23.7019 9.81184 24.2115C10.3678 24.7211 11.0953 25.0026 11.8495 25H20.1694C20.9236 25.0026 21.6511 24.7211 22.2071 24.2115C22.763 23.7019 23.1066 23.0016 23.1694 22.25L23.9294 13.17C23.9469 12.8933 23.908 12.6159 23.8152 12.3547C23.7224 12.0934 23.5776 11.8537 23.3894 11.65ZM13.9994 10C13.9994 9.46957 14.2102 8.96086 14.5852 8.58578C14.9603 8.21071 15.469 8 15.9994 8C16.5299 8 17.0386 8.21071 17.4137 8.58578C17.7887 8.96086 17.9994 9.46957 17.9994 10V11H13.9994V10Z"/></svg>`
      };

      // Helper to generate quadratic Bezier curves for routes
      const getCurvePath = (x1, y1, x2, y2) => {
        const ctrlX = (x1 + x2) / 2;
        const ctrlY = Math.min(y1, y2) - 60;
        return `M ${x1} ${y1} Q ${ctrlX} ${ctrlY} ${x2} ${y2}`;
      };

      // Draw Routes and Country Destinations dynamically
      countriesData.forEach((country, index) => {
        const pathD = getCurvePath(origin.x, origin.y, country.x, country.y);
        
        // 1. Draw Background Route Arc Path
        const pathEl = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        pathEl.setAttribute('id', `route-path-${index}`);
        pathEl.setAttribute('class', 'route-arc-path');
        pathEl.setAttribute('d', pathD);
        routesLayer.appendChild(pathEl);

        // 2. Draw Animating Signal Line (Outwards from India simultaneously)
        const signalEl = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        signalEl.setAttribute('class', 'signal-line');
        signalEl.setAttribute('d', pathD);
        // Stagger delays slightly for aesthetic natural look
        signalEl.style.animationDelay = `${index * -0.37}s`;
        routesLayer.appendChild(signalEl);

        // 3. Draw Destination interactive Dot Group
        const destGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        destGroup.setAttribute('class', 'dest-interactive-group');
        destGroup.setAttribute('transform', `translate(${country.x}, ${country.y})`);
        destGroup.dataset.index = index;

        destGroup.innerHTML = `
          <circle cx="0" cy="0" r="14" fill="#fc9f30" opacity="0.15" />
          <circle cx="0" cy="0" r="6" class="dest-dot-core" fill="#fc9f30" stroke="#ffffff" stroke-width="1.5" />
        `;
        destinationsLayer.appendChild(destGroup);

        // 4. Create Tooltip HTML overlay card
        const tooltip = document.createElement('div');
        tooltip.setAttribute('id', `tooltip-${index}`);
        tooltip.setAttribute('class', 'trade-map-tooltip');
        
        // Build brand cargo items (logos floating out of the box)
        let brandCargoHtml = '';
        const offsets = [
          { tx: -15, ty: -10, r: -12, s: 1.0, delay: 0.1 },
          { tx: 15, ty: -12, r: 18, s: 1.0, delay: 0.15 },
          { tx: 0, ty: -25, r: -6, s: 0.95, delay: 0.2 },
          { tx: -10, ty: -40, r: 24, s: 0.9, delay: 0.25 },
          { tx: 12, ty: -36, r: -16, s: 0.85, delay: 0.3 }
        ];

        country.brands.forEach((bName, idx) => {
          const cleanName = bName.trim();
          if (!cleanName) return;

          // Find brand block in brandsData
          const matchedBrand = brandsData.find(b => b.name.toLowerCase() === cleanName.toLowerCase());
          const offset = offsets[idx % offsets.length];
          const tx = offset.tx;
          const ty = offset.ty;
          const r = offset.r;
          const s = offset.s;
          const delay = offset.delay;
          
          if (matchedBrand && matchedBrand.logo) {
            brandCargoHtml += `
              <div class="cargo-item" title="${cleanName}" style="--tx: ${tx}px; --ty: ${ty}px; --r: ${r}deg; --s: ${s}; --delay: ${delay}s">
                <img src="${matchedBrand.logo}" class="cargo-brand-logo" alt="${cleanName}" style="width: 100%; height: 100%; object-fit: contain; filter: brightness(0) opacity(0.85);" />
              </div>
            `;
          } else {
            // Match custom defaults or platforms
            let brandLogoSvg = '';
            const cleanNameLower = cleanName.toLowerCase();
            if (cleanNameLower.includes('crocon') || cleanNameLower.includes('adil') || cleanNameLower.includes('kasutam') || cleanNameLower.includes('amazon')) {
              brandLogoSvg = platformSVGs['amazon'];
            } else if (cleanNameLower.includes('plix') || cleanNameLower.includes('mars') || cleanNameLower.includes('flipkart')) {
              brandLogoSvg = platformSVGs['flipkart'];
            } else if (cleanNameLower.includes('folello') || cleanNameLower.includes('himali') || cleanNameLower.includes('meesho')) {
              brandLogoSvg = platformSVGs['meesho'];
            } else if (cleanNameLower.includes('adda') || cleanNameLower.includes('jiomart')) {
              brandLogoSvg = platformSVGs['jiomart'];
            } else {
              const keys = ['amazon', 'flipkart', 'meesho', 'jiomart'];
              brandLogoSvg = platformSVGs[keys[idx % keys.length]];
            }

            brandCargoHtml += `
              <div class="cargo-item" title="${cleanName}" style="--tx: ${tx}px; --ty: ${ty}px; --r: ${r}deg; --s: ${s}; --delay: ${delay}s">
                ${brandLogoSvg}
              </div>
            `;
          }
        });

        tooltip.innerHTML = `
          <div class="tooltip-header flex items-center justify-center gap-1.5 bg-white/95 border border-brand-orange/20 shadow-md py-1 px-3 rounded-full text-xs font-bold text-brand-coffee backdrop-blur-md mb-2">
            <span class="text-sm leading-none">${country.flag}</span>
            <span class="font-display tracking-tight">${country.name}</span>
          </div>

          <div class="tooltip-box-wrapper">
            <!-- Cargo Items Container (Brand Logos floating out of the box) -->
            <div class="tooltip-cargo">
              ${brandCargoHtml}
            </div>

            <!-- Open Box SVG (scaled to 80px) -->
            <svg class="open-box-svg" viewBox="0 0 80 80" width="80" height="80" fill="none" xmlns="http://www.w3.org/2000/svg">
              <ellipse cx="40" cy="74" rx="24" ry="5" fill="#26180f" opacity="0.18" />
              
              <g class="box-lids">
                <polygon points="15,42 40,30 20,18 -5,30" class="box-lid-left" fill="#fc9f30" stroke="#26180f" stroke-width="1.5" />
                <polygon points="40,30 65,42 85,30 60,18" class="box-lid-right" fill="#fc9f30" stroke="#26180f" stroke-width="1.5" />
              </g>
              
              <g class="box-body">
                <polygon points="40,55 15,42 15,62 40,75" fill="#d8841a" stroke="#26180f" stroke-width="1.5" />
                <polygon points="40,55 65,42 65,62 40,75" fill="#a45f0b" stroke="#26180f" stroke-width="1.5" />
                <polygon points="40,55 15,42 40,30 65,42" fill="#26180f" opacity="0.25" />
              </g>
            </svg>
          </div>
        `;
        tooltipsContainer.appendChild(tooltip);

        // Position tooltip card dynamically
        const updateTooltipPosition = () => {
          const containerRect = container.getBoundingClientRect();
          // Scale coords to current container size
          const scaleX = containerRect.width / 1211;
          const scaleY = containerRect.height / 590;

          const screenX = country.x * scaleX;
          const screenY = country.y * scaleY;

          tooltip.style.left = `${screenX - 60}px`;
          tooltip.style.top = `${screenY - 118}px`; // Sits perfectly above the dot
        };

        // Initialize position & bind resize listener
        updateTooltipPosition();
        window.addEventListener('resize', updateTooltipPosition);

        // Bind hover events on destination group
        destGroup.addEventListener('mouseenter', () => {
          tooltip.classList.add('visible');
          pathEl.classList.add('active');
        });
        destGroup.addEventListener('mouseleave', () => {
          tooltip.classList.remove('visible');
          pathEl.classList.remove('active');
        });

        // Touch support for mobile devices
        destGroup.addEventListener('touchstart', (e) => {
          e.preventDefault();
          const visible = tooltip.classList.contains('visible');
          document.querySelectorAll('.trade-map-tooltip').forEach(el => el.classList.remove('visible'));
          document.querySelectorAll('.route-arc-path').forEach(el => el.classList.remove('active'));
          
          if (!visible) {
            tooltip.classList.add('visible');
            pathEl.classList.add('active');
          }
        });
      });

      // Clear any click out focus on mobile
      document.addEventListener('touchstart', (e) => {
        if (!e.target.closest('.dest-interactive-group')) {
          document.querySelectorAll('.trade-map-tooltip').forEach(el => el.classList.remove('visible'));
          document.querySelectorAll('.route-arc-path').forEach(el => el.classList.remove('active'));
        }
      });

      // Logistics Parcel Animation Loop Engine
      const startParcelLoop = (countryIndex) => {
        const country = countriesData[countryIndex];
        const routePath = document.getElementById(`route-path-${countryIndex}`);
        if (!country || !routePath) return;

        const pathLength = routePath.getTotalLength();

        // 1. Create 3D parcel element
        const parcel = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        parcel.setAttribute('class', 'animating-parcel');

        // Premium isometric 3D box drawing scaled to double size with coffee-brown outlines
        parcel.innerHTML = `
          <!-- Top Face -->
          <polygon points="0,-12 14,-6 0,0 -14,-6" fill="#fc9f30" stroke="#26180f" stroke-width="0.8" stroke-linejoin="round" />
          <!-- Left Face -->
          <polygon points="-14,-6 0,0 0,12 -14,6" fill="#d8841a" stroke="#26180f" stroke-width="0.8" stroke-linejoin="round" />
          <!-- Right Face -->
          <polygon points="0,0 14,-6 14,12 0,12" fill="#a45f0b" stroke="#26180f" stroke-width="0.8" stroke-linejoin="round" />
        `;
        // Position initially at India start node to prevent top-left rendering flash
        parcel.setAttribute('transform', `translate(738, 328)`);
        routesLayer.parentNode.appendChild(parcel);

        let startTime = null;
        const duration = 2800 + Math.random() * 1200; // Variable speed per route (2.8s - 4s)

        const step = (timestamp) => {
          if (!startTime) startTime = timestamp;
          const progress = (timestamp - startTime) / duration;

          if (progress < 1) {
            const currentDist = progress * pathLength;
            const point = routePath.getPointAtLength(currentDist);
            parcel.setAttribute('transform', `translate(${point.x}, ${point.y})`);
            
            requestAnimationFrame(step);
          } else {
            // Parcel has reached destination!
            if (parcel.parentNode) {
              parcel.parentNode.removeChild(parcel);
            }
            
            // Loop next parcel after a small delay
            setTimeout(() => {
              startParcelLoop(countryIndex);
            }, 800 + Math.random() * 1500); // Stagger loops naturally
          }
        };

        requestAnimationFrame(step);
      };



      // Spawner loop
      const startLogisticsEngine = () => {
        if (countriesData.length === 0) return;

        // Run parcel loops on ALL routes simultaneously
        countriesData.forEach((_, idx) => {
          // Stagger the first spawn of each route slightly for a natural start
          setTimeout(() => {
            startParcelLoop(idx);
          }, idx * 450);
        });
      };

      // Start logistics engine directly on load (bypassing intersection observer bugs in theme editor frame)
      startLogisticsEngine();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTradeMap);
    } else {
      initTradeMap();
    }

    document.addEventListener('shopify:section:load', (e) => {
      if (e.target.querySelector('#walbayzon-trade-map-container')) {
        initTradeMap();
      }
    });
  })();
</script>

