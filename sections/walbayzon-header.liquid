<script>
  document.addEventListener('DOMContentLoaded', function() {
    const toggle = document.getElementById('wb-mobile-toggle');
    const menu = document.getElementById('wb-mobile-menu');
    if(toggle && menu) {
      toggle.addEventListener('click', function() {
        menu.classList.toggle('hidden');
        const lines = toggle.querySelectorAll('span');
        if(lines.length === 3) {
          lines[0].classList.toggle('rotate-45');
          lines[0].classList.toggle('translate-y-[7px]');
          lines[1].classList.toggle('opacity-0');
          lines[2].classList.toggle('-rotate-45');
          lines[2].classList.toggle('-translate-y-[7px]');
        }
      });
    }

    // Mobile Accordion toggles
    const accordions = document.querySelectorAll('[data-wb-accordion]');
    accordions.forEach(button => {
      button.addEventListener('click', function(e) {
        e.preventDefault();
        const targetId = `acc-${this.getAttribute('data-wb-accordion')}`;
        const targetDiv = document.getElementById(targetId);
        const icon = this.querySelector('svg');
        
        if (targetDiv) {
          const isHidden = targetDiv.classList.contains('hidden');
          targetDiv.classList.toggle('hidden');
          if (icon) {
            if (isHidden) {
              icon.classList.add('rotate-180');
            } else {
              icon.classList.remove('rotate-180');
            }
          }
        }
      });
    });

    // Scroll listener for sticky glassy effect — header always sits below fixed announcement
    const header = document.querySelector('.walbayzon-header-el');
    const announcement = document.querySelector('.walbayzon-announcement');
    if (header) {
      const handleScroll = () => {
        const announcementHeight = announcement ? announcement.offsetHeight : 0;
        // Header always sits directly below the fixed announcement bar
        header.style.top = `${announcementHeight}px`;
        if (window.scrollY > 10) {
          header.classList.add('is-scrolled');
        } else {
          header.classList.remove('is-scrolled');
        }
      };
      handleScroll();
      window.addEventListener('scroll', handleScroll, { passive: true });
      window.addEventListener('resize', handleScroll);
    }
  });
</script>

