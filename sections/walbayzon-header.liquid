{% comment %}
  Walbayzon Navigation Header Section
  Compatible with Shopify Theme Editor
{% endcomment %}

<header class="sticky top-0 left-0 right-0 z-40 bg-white/85 backdrop-blur-lg border-b border-soft-border transition-all duration-300">
  <div class="max-w-[1200px] mx-auto px-6 h-[72px] flex items-center justify-between">
    
    <!-- Logo & Live Indicator -->
    <a href="{{ routes.root_url }}" class="flex items-center gap-2.5 select-none">
      {% if section.settings.logo != blank %}
        <img src="{{ section.settings.logo | image_url: width: 150 }}" 
             alt="{{ shop.name }}" 
             style="max-height: {{ section.settings.logo_max_height }}px;" 
             class="object-contain" />
      {% else %}
        <div class="grid h-9 w-9 place-items-center rounded-full bg-primary" style="background-color: {{ section.settings.logo_bg_color }};">
          <span class="font-display text-base font-black text-primary-foreground" style="color: {{ section.settings.logo_text_color }};">
            {{ section.settings.logo_letter }}<span style="color: {{ section.settings.logo_dot_color }};">.</span>
          </span>
        </div>
        <span class="font-display text-lg font-bold tracking-tight text-foreground">{{ section.settings.logo_text }}</span>
      {% endif %}
      
      {% if section.settings.show_live_indicator %}
        <span class="live-dot" title="Operations Active"></span>
      {% endif %}
    </a>

    <!-- Navigation Menu (Desktop) -->
    <nav class="hidden lg:flex items-center gap-7">
      {% for link in linklists[section.settings.menu].links %}
        <a href="{{ link.url }}" class="text-[15px] font-semibold text-charcoal hover:text-primary transition-colors duration-300">
          {{ link.title }}
        </a>
      {% else %}
        <!-- Default Menu if none selected -->
        <a href="#services" class="text-[15px] font-semibold text-charcoal hover:text-primary transition-colors duration-300">Services</a>
        <a href="#mentorship" class="text-[15px] font-semibold text-charcoal hover:text-primary transition-colors duration-300">Mentorship</a>
        <a href="#mastercourse" class="text-[15px] font-semibold text-charcoal hover:text-primary transition-colors duration-300">Mastercourse</a>
        <a href="#team" class="text-[15px] font-semibold text-charcoal hover:text-primary transition-colors duration-300">Our Team</a>
        <a href="#methodology" class="text-[15px] font-semibold text-charcoal hover:text-primary transition-colors duration-300">Methodology</a>
        <a href="#faq" class="text-[15px] font-semibold text-charcoal hover:text-primary transition-colors duration-300">FAQ</a>
      {% endfor %}
    </nav>

    <!-- Call to Actions -->
    <div class="flex items-center gap-4">
      {% if section.settings.btn1_text != blank %}
        <a href="{{ section.settings.btn1_url }}" class="hidden sm:inline-block text-[14px] font-semibold text-charcoal hover:text-primary transition-colors duration-300">
          {{ section.settings.btn1_text }}
        </a>
      {% endif %}
      {% if section.settings.btn2_text != blank %}
        <a href="{{ section.settings.btn2_url }}" class="btn-shimmer px-5 py-2.5 rounded-[10px] bg-primary hover:bg-primary-hover font-outfit text-[14px] font-bold text-charcoal shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-primary/20 cursor-pointer">
          {{ section.settings.btn2_text }}
        </a>
      {% endif %}
      
      <!-- Mobile Menu Toggle Button -->
      <button id="wb-mobile-toggle" class="lg:hidden flex flex-col gap-[5px] cursor-pointer p-1" aria-label="Toggle menu">
        <span class="w-[22px] h-[2px] bg-charcoal transition-all duration-300"></span>
        <span class="w-[22px] h-[2px] bg-charcoal transition-all duration-300"></span>
        <span class="w-[22px] h-[2px] bg-charcoal transition-all duration-300"></span>
      </button>
    </div>

  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="wb-mobile-menu" class="hidden lg:hidden border-t border-soft-border bg-white px-6 py-4 space-y-3 shadow-md">
    {% for link in linklists[section.settings.menu].links %}
      <a href="{{ link.url }}" class="block text-[16px] font-semibold text-charcoal py-2 hover:text-primary transition-colors">
        {{ link.title }}
      </a>
    {% else %}
      <a href="#services" class="block text-[16px] font-semibold text-charcoal py-2 hover:text-primary transition-colors">Services</a>
      <a href="#mentorship" class="block text-[16px] font-semibold text-charcoal py-2 hover:text-primary transition-colors">1-on-1 Mentorship</a>
      <a href="#mastercourse" class="block text-[16px] font-semibold text-charcoal py-2 hover:text-primary transition-colors">Mastercourse</a>
      <a href="#team" class="block text-[16px] font-semibold text-charcoal py-2 hover:text-primary transition-colors">Our Team</a>
      <a href="#methodology" class="block text-[16px] font-semibold text-charcoal py-2 hover:text-primary transition-colors">Methodology</a>
      <a href="#faq" class="block text-[16px] font-semibold text-charcoal py-2 hover:text-primary transition-colors">FAQ</a>
    {% endfor %}
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const toggle = document.getElementById('wb-mobile-toggle');
    const menu = document.getElementById('wb-mobile-menu');
    if(toggle && menu) {
      toggle.addEventListener('click', function() {
        menu.classList.toggle('hidden');
        const lines = toggle.querySelectorAll('span');
        if(lines.length === 3) {
          lines[0].classList.toggle('rotate-45');
          lines[0].classList.toggle('translate-y-[7px]');
          lines[1].classList.toggle('opacity-0');
          lines[2].classList.toggle('-rotate-45');
          lines[2].classList.toggle('-translate-y-[7px]');
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Walbayzon Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Logo Image"
    },
    {
      "type": "range",
      "id": "logo_max_height",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Logo Max Height",
      "default": 35
    },
    {
      "type": "text",
      "id": "logo_letter",
      "label": "Logo Single Letter (Fall back)",
      "default": "W"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text (Fall back)",
      "default": "Walbayzon"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu"
    },
    {
      "type": "checkbox",
      "id": "show_live_indicator",
      "label": "Show Live Indicator Dot",
      "default": true
    },
    {
      "type": "color",
      "id": "live_indicator_color",
      "label": "Live Indicator Dot Color",
      "default": "#f97316"
    },
    {
      "type": "color",
      "id": "logo_bg_color",
      "label": "Logo Icon Background Color",
      "default": "#2c221e"
    },
    {
      "type": "color",
      "id": "logo_text_color",
      "label": "Logo Icon Text Color",
      "default": "#fbf8f5"
    },
    {
      "type": "color",
      "id": "logo_dot_color",
      "label": "Logo Icon Dot Color",
      "default": "#f97316"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Section Border Color",
      "default": "#1d1d1b"
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Button Shadow Color",
      "default": "#1d1d1b"
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Button 1 Text",
      "default": "Sign In"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Button 2 Text",
      "default": "Let's Connect"
    },
    {
      "type": "url",
      "id": "btn2_url",
      "label": "Button 2 Link"
    },
    {
      "type": "color",
      "id": "btn2_bg",
      "label": "Button 2 Background Color",
      "default": "#f97316"
    }
  ],
  "presets": [
    {
      "name": "Walbayzon Header"
    }
  ]
}
{% endschema %}
