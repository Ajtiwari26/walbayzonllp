      {% else %}
        <div class="grid h-9 w-9 place-items-center rounded-full bg-primary">
          <span class="font-display text-base font-black text-primary-foreground">
            {{ section.settings.logo_letter }}<span class="text-brand-orange">.</span>
          </span>
        </div>
        <span class="font-display text-lg font-bold tracking-tight text-foreground">{{ section.settings.logo_text }}</span>
      {% endif %}
      
      {% if section.settings.show_live_indicator %}
        <span class="live-dot" title="Operations Active"></span>
      {% endif %}
