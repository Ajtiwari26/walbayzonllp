{% comment %}
  Walbayzon Navigation Header Section
  Compatible with Shopify Theme Editor
{% endcomment %}

<style>
  /* Keep layout space for the fixed announcement + header */
  #shopify-section-header,
  [id*="--header"] {
    height: 100px;
    z-index: 50;
  }
  @media (min-width: 1024px) {
    #shopify-section-header,
    [id*="--header"] {
      height: 116px;
    }
  }
  
  .walbayzon-header-el {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    width: 100%;
    background-color: oklch(0.69 0.005 60 / 0.5) !important;
    backdrop-filter: blur(24px) !important;
    -webkit-backdrop-filter: blur(24px) !important;
    border-bottom: 1px solid oklch(0.61 0.015 50 / 0.11) !important;
    transition: background-color 0.3s ease, border-color 0.3s ease, backdrop-filter 0.3s ease, box-shadow 0.3s ease;
  }

  /* Solid white strip behind header so glass looks white at top */
  .walbayzon-header-el::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #ffffff;
    opacity: 0.85;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .walbayzon-header-el.is-scrolled::before {
    opacity: 0;
  }

  /* Add dynamic shadow on scroll */
  .walbayzon-header-el.is-scrolled {
    background-color: oklch(0.99 0.005 80 / 0.55) !important;
    backdrop-filter: blur(24px) !important;
    -webkit-backdrop-filter: blur(24px) !important;
    border-bottom: 1px solid oklch(0.91 0.015 70 / 0.6) !important;
    box-shadow: 0 4px 20px -5px rgba(0, 0, 0, 0.05);
  }

  /* Megamenu layout & animation rules */
  .walbayzon-megamenu {
    position: absolute;
    left: 50%;
    top: 100%;
    z-index: 50;
    margin-top: 0.5rem;
    width: 820px;
    transform: translateX(-50%) translateY(10px) scale(0.95);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1), transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.25s;
    pointer-events: none;
  }
  .walbayzon-megamenu::before {
    content: '';
    position: absolute;
    top: -20px;
    left: 0;
    right: 0;
    height: 20px;
    background: transparent;
  }
  .group:hover .walbayzon-megamenu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0) scale(1);
    pointer-events: auto;
  }

  /* More dropdown layout & animation rules */
  .walbayzon-dropdown-more {
    position: absolute;
    left: 0;
    top: 100%;
    z-index: 50;
    margin-top: 0.5rem;
    width: 12rem;
    transform: translateY(10px) scale(0.95);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1), transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.25s;
    pointer-events: none;
  }
  .walbayzon-dropdown-more::before {
    content: '';
    position: absolute;
    top: -20px;
    left: 0;
    right: 0;
    height: 20px;
    background: transparent;
  }
  .group:hover .walbayzon-dropdown-more {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  /* Glass card container with solid opacity */
  .walbayzon-glass-card {
    background-color: rgba(255, 255, 255, 0.99) !important;
    border: 1px solid rgba(29, 29, 27, 0.08) !important;
    backdrop-filter: blur(20px) !important;
    -webkit-backdrop-filter: blur(20px) !important;
  }
  
  [data-scheme=dark] .walbayzon-glass-card,
  @media (prefers-color-scheme: dark) {
    [data-scheme=auto] .walbayzon-glass-card {
      background-color: rgba(30, 30, 30, 0.99) !important;
      border: 1px solid rgba(255, 255, 255, 0.1) !important;
    }
  }

  /* Sub-service link block hover animations */
  .walbayzon-sub-link {
    display: block;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .walbayzon-sub-link:hover {
    transform: translateX(4px);
  }
  .walbayzon-sub-link .arrow-icon {
    display: inline-block;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .walbayzon-sub-link:hover .arrow-icon {
    opacity: 1;
    transform: translateX(0);
  }
</style>

