{% comment %}
  Walbayzon Testimonials Section
  Compatible with Shopify Theme Editor
{% endcomment %}

<section class="bg-soft-pearl py-16 sm:py-24 lg:py-32 relative overflow-hidden z-10">
  
  <!-- Floating Chat Birds Background Layer -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none select-none z-0">
    
    <!-- Bird 1 (Orange, fast path bottom-left to top-right) -->
    <div class="chat-bird bird-path-1 text-brand-orange">
      <div class="bird-body">
        <div class="wing left-wing"><svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full"><path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" /></svg></div>
        <div class="bird-msg border-brand-orange/20 text-brand-coffee">Amazon USA Launch</div>
        <div class="wing right-wing"><svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full"><path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" /></svg></div>
      </div>
    </div>

    <!-- Bird 2 (Coffee, slow path bottom-right to top-left) -->
    <div class="chat-bird bird-path-2 text-brand-coffee">
      <div class="bird-body">
        <div class="wing left-wing"><svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full"><path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" /></svg></div>
        <div class="bird-msg border-brand-coffee/20 text-brand-coffee">Walmart Marketplace</div>
        <div class="wing right-wing"><svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full"><path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" /></svg></div>
      </div>
    </div>

    <!-- Bird 3 (Orange, floating left) -->
    <div class="chat-bird bird-path-3 text-brand-orange">
      <div class="bird-body">
        <div class="wing left-wing"><svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full"><path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" /></svg></div>
        <div class="bird-msg border-brand-orange/20 text-brand-coffee">5X Revenue Growth</div>
        <div class="wing right-wing"><svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full"><path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" /></svg></div>
      </div>
    </div>

    <!-- Bird 4 (Coffee, floating right) -->
    <div class="chat-bird bird-path-4 text-brand-coffee">
      <div class="bird-body">
        <div class="wing left-wing"><svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full"><path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" /></svg></div>
        <div class="bird-msg border-brand-coffee/20 text-brand-coffee">Brand Registry</div>
        <div class="wing right-wing"><svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full"><path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" /></svg></div>
      </div>
    </div>

    <!-- Bird 5 (Orange, middle path left to right) -->
    <div class="chat-bird bird-path-5 text-brand-orange">
      <div class="bird-body">
        <div class="wing left-wing"><svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full"><path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" /></svg></div>
        <div class="bird-msg border-brand-orange/20 text-brand-coffee">Global Expansion</div>
        <div class="wing right-wing"><svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full"><path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" /></svg></div>
      </div>
    </div>

    <!-- Bird 6 (Coffee, low path left to right) -->
    <div class="chat-bird bird-path-6 text-brand-coffee">
      <div class="bird-body">
        <div class="wing left-wing"><svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full"><path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" /></svg></div>
        <div class="bird-msg border-brand-coffee/20 text-brand-coffee">FBA Logistics</div>
        <div class="wing right-wing"><svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full"><path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" /></svg></div>
      </div>
    </div>

    <!-- Bird 7 (Orange, high right to left) -->
    <div class="chat-bird bird-path-7 text-brand-orange">
      <div class="bird-body">
        <div class="wing left-wing"><svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full"><path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" /></svg></div>
        <div class="bird-msg border-brand-orange/20 text-brand-coffee">Amazon PPC</div>
        <div class="wing right-wing"><svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full"><path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" /></svg></div>
      </div>
    </div>

    <!-- Bird 8 (Coffee, floating high center) -->
    <div class="chat-bird bird-path-8 text-brand-coffee">
      <div class="bird-body">
        <div class="wing left-wing"><svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full"><path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" /></svg></div>
        <div class="bird-msg border-brand-coffee/20 text-brand-coffee">Shopify Growth</div>
        <div class="wing right-wing"><svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full"><path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" /></svg></div>
      </div>
    </div>

    <!-- Bird 9 (Orange, floating low left) -->
    <div class="chat-bird bird-path-9 text-brand-orange">
      <div class="bird-body">
        <div class="wing left-wing"><svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full"><path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" /></svg></div>
        <div class="bird-msg border-brand-orange/20 text-brand-coffee">Cross-Border Ecommerce</div>
        <div class="wing right-wing"><svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full"><path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" /></svg></div>
      </div>
    </div>

    <!-- Bird 10 (Coffee, bottom-left to top-left arch) -->
    <div class="chat-bird bird-path-10 text-brand-coffee">
      <div class="bird-body">
        <div class="wing left-wing"><svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full"><path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" /></svg></div>
        <div class="bird-msg border-brand-coffee/20 text-brand-coffee">Account Management</div>
        <div class="wing right-wing"><svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full"><path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" /></svg></div>
      </div>
    </div>

  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-5 lg:px-8 relative z-10">
    
    <!-- Header -->
    <div class="relative z-10">
      {% if section.settings.sub_title != blank %}
        <p class="text-xs font-medium uppercase tracking-[0.2em]" style="color: {{ section.settings.accent_color }};">
          {{ section.settings.sub_title }}
        </p>
      {% endif %}
      <h2 class="mt-4 max-w-2xl font-display text-3xl font-bold leading-[1.1] tracking-tight text-balance sm:text-4xl md:text-5xl lg:text-6xl text-foreground">
        {{ section.settings.title }}
      </h2>
    </div>

    <!-- Testimonials Grid -->
    <div id="testimonials-grid" class="mt-12 grid gap-5 sm:mt-16 md:grid-cols-2 lg:grid-cols-3 relative z-10">
      {% for block in section.blocks %}
        <figure class="flex flex-col justify-between rounded-3xl border border-border glass-card p-6 sm:p-8 card-lift" {{ block.shopify_attributes }}>
          <div>
            <!-- Quote Icon -->
            <span style="color: {{ section.settings.accent_color }};">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="28" height="28">
                <path d="M3 21c3 0 7-1 7-8V5H3v9h4"/><path d="M14 21c3 0 7-1 7-8V5h-7v9h4"/>
              </svg>
            </span>
            <blockquote class="mt-5 text-base leading-relaxed text-foreground text-balance sm:text-lg">
              "{{ block.settings.quote }}"
            </blockquote>
          </div>
          
          <figcaption class="mt-8 flex items-center justify-between border-t border-border pt-5">
            <div>
              <div class="font-display text-sm font-bold text-foreground">{{ block.settings.author_name }}</div>
              <div class="text-xs text-muted-foreground">{{ block.settings.author_role }}</div>
            </div>
            
            <!-- Rating Stars -->
            <div class="flex gap-0.5" style="color: {{ section.settings.accent_color }};">
              {% for i in (1..block.settings.rating) %}
                <span class="inline-flex">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                  </svg>
                </span>
              {% endfor %}
            </div>
          </figcaption>
        </figure>
      {% else %}
        <!-- Fallbacks -->
        {% assign quotes = "Walbayzon rebuilt our Amazon presence from the ground up. We 4× revenue in eight months without expanding our ad budget.|The team feels like an extension of ours. Sharp creative, sharper numbers — and zero hand-holding required.|From India to UAE in 90 days. The localisation playbook is genuinely best in class." | split: "|" %}
        {% assign names = "Aarav Mehta|Priya Nair|Kabir Singh" | split: "|" %}
        {% assign roles = "Founder, Crocon Home|CEO, Tindora Wellness|CMO, Norta Beauty" | split: "|" %}
        {% for quote in quotes %}
          {% assign idx = forloop.index0 %}
          <figure class="flex flex-col justify-between rounded-3xl border border-border glass-card p-6 sm:p-8 card-lift">
            <div>
              <span style="color: {{ section.settings.accent_color }};">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="28" height="28">
                  <path d="M3 21c3 0 7-1 7-8V5H3v9h4"/><path d="M14 21c3 0 7-1 7-8V5h-7v9h4"/>
                </svg>
              </span>
              <blockquote class="mt-5 text-base leading-relaxed text-foreground text-balance sm:text-lg">
                "{{ quote }}"
              </blockquote>
            </div>
            <figcaption class="mt-8 flex items-center justify-between border-t border-border pt-5">
              <div>
                <div class="font-display text-sm font-bold text-foreground">{{ names[idx] }}</div>
                <div class="text-xs text-muted-foreground">{{ roles[idx] }}</div>
              </div>
              <div class="flex gap-0.5" style="color: {{ section.settings.accent_color }};">
                {% for i in (1..5) %}
                  <span class="inline-flex">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                    </svg>
                  </span>
                {% endfor %}
              </div>
            </figcaption>
          </figure>
        {% endfor %}
      {% endfor %}
    </div>

  </div>
</section>

<style>
  /* Flying Chat Birds styles */
  .chat-bird {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 600px;
    pointer-events: none;
    user-select: none;
    opacity: 0;
  }
  .bird-body {
    display: flex;
    align-items: center;
    justify-content: center;
    transform-style: preserve-3d;
    position: relative;
  }
  .wing {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
  }
  .left-wing {
    transform-origin: right center;
    transform: scaleX(-1);
    animation: flap-left 0.6s ease-in-out infinite;
  }
  .right-wing {
    transform-origin: left center;
    animation: flap-right 0.6s ease-in-out infinite;
  }
  .bird-msg {
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid;
    padding: 6px 18px;
    border-radius: 9999px;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.02em;
    box-shadow: 0 8px 12px -2px rgba(0,0,0,0.05), 0 4px 6px -2px rgba(0,0,0,0.03);
    backdrop-filter: blur(4px);
    white-space: nowrap;
    user-select: none;
    margin: 0 8px;
  }

  @keyframes flap-left {
    0% { transform: scaleX(-1) rotateY(0deg); }
    50% { transform: scaleX(-1) rotateY(55deg); }
    100% { transform: scaleX(-1) rotateY(0deg); }
  }
  @keyframes flap-right {
    0% { transform: rotateY(0deg); }
    50% { transform: rotateY(-55deg); }
    100% { transform: rotateY(0deg); }
  }

  /* Flight paths using responsive viewport widths (vw) */
  .bird-path-1 { animation: fly-path-1 14s linear infinite; }
  .bird-path-2 { animation: fly-path-2 18s linear infinite; animation-delay: 3s; }
  .bird-path-3 { animation: float-path-3 10s ease-in-out infinite; }
  .bird-path-4 { animation: float-path-4 12s ease-in-out infinite; animation-delay: 2s; }
  .bird-path-5 { animation: fly-path-5 12s linear infinite; animation-delay: 6s; }
  .bird-path-6 { animation: fly-path-6 16s linear infinite; animation-delay: 4s; }
  .bird-path-7 { animation: fly-path-7 15s linear infinite; animation-delay: 8s; }
  .bird-path-8 { animation: float-path-8 14s ease-in-out infinite; animation-delay: 1s; }
  .bird-path-9 { animation: float-path-9 11s ease-in-out infinite; animation-delay: 5s; }
  .bird-path-10 { animation: fly-path-10 17s linear infinite; animation-delay: 2s; }

  @keyframes fly-path-1 {
    0% { transform: translate(-20vw, 350px) scale(0.45) rotate(15deg); opacity: 0; }
    15% { opacity: 0.5; }
    85% { opacity: 0.5; }
    100% { transform: translate(110vw, -50px) scale(0.7) rotate(5deg); opacity: 0; }
  }
  @keyframes fly-path-2 {
    0% { transform: translate(110vw, 300px) scale(0.6) rotate(-20deg); opacity: 0; }
    15% { opacity: 0.45; }
    85% { opacity: 0.45; }
    100% { transform: translate(-20vw, 20px) scale(0.45) rotate(-5deg); opacity: 0; }
  }
  @keyframes float-path-3 {
    0% { transform: translate(10vw, 120px) scale(0.5) rotate(0deg); opacity: 0.4; }
    50% { transform: translate(18vw, 220px) scale(0.6) rotate(8deg); opacity: 0.6; }
    100% { transform: translate(10vw, 120px) scale(0.5) rotate(0deg); opacity: 0.4; }
  }
  @keyframes float-path-4 {
    0% { transform: translate(80vw, 240px) scale(0.55) rotate(5deg); opacity: 0.42; }
    50% { transform: translate(72vw, 100px) scale(0.5) rotate(-5deg); opacity: 0.52; }
    100% { transform: translate(80vw, 240px) scale(0.55) rotate(5deg); opacity: 0.42; }
  }
  @keyframes fly-path-5 {
    0% { transform: translate(-20vw, 80px) scale(0.55) rotate(5deg); opacity: 0; }
    15% { opacity: 0.55; }
    85% { opacity: 0.55; }
    100% { transform: translate(110vw, 220px) scale(0.7) rotate(10deg); opacity: 0; }
  }
  @keyframes fly-path-6 {
    0% { transform: translate(-20vw, 400px) scale(0.5) rotate(10deg); opacity: 0; }
    15% { opacity: 0.5; }
    85% { opacity: 0.5; }
    100% { transform: translate(110vw, 150px) scale(0.65) rotate(5deg); opacity: 0; }
  }
  @keyframes fly-path-7 {
    0% { transform: translate(110vw, 180px) scale(0.65) rotate(-15deg); opacity: 0; }
    15% { opacity: 0.48; }
    85% { opacity: 0.48; }
    100% { transform: translate(-20vw, 320px) scale(0.5) rotate(-5deg); opacity: 0; }
  }
  @keyframes float-path-8 {
    0% { transform: translate(45vw, 60px) scale(0.55) rotate(0deg); opacity: 0.45; }
    50% { transform: translate(52vw, 140px) scale(0.6) rotate(-5deg); opacity: 0.55; }
    100% { transform: translate(45vw, 60px) scale(0.55) rotate(0deg); opacity: 0.45; }
  }
  @keyframes float-path-9 {
    0% { transform: translate(15vw, 280px) scale(0.5) rotate(-5deg); opacity: 0.4; }
    50% { transform: translate(8vw, 340px) scale(0.55) rotate(5deg); opacity: 0.5; }
    100% { transform: translate(15vw, 280px) scale(0.5) rotate(-5deg); opacity: 0.4; }
  }
  @keyframes fly-path-10 {
    0% { transform: translate(-20vw, 200px) scale(0.5) rotate(20deg); opacity: 0; }
    15% { opacity: 0.45; }
    85% { opacity: 0.45; }
    100% { transform: translate(110vw, 50px) scale(0.7) rotate(0deg); opacity: 0; }
  }
</style>

{% schema %}
{
  "name": "Walbayzon Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "sub_title",
      "label": "Sub Title",
      "default": "— Founders on Walbayzon"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "The team founders trust to own their growth."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#fc9f30"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Walbayzon rebuilt our Amazon presence from the ground up. We 4× revenue in eight months without expanding our ad budget."
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name",
          "default": "Aarav Mehta"
        },
        {
          "type": "text",
          "id": "author_role",
          "label": "Author Role",
          "default": "Founder, Crocon Home"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star Rating",
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Walbayzon Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "author_name": "Aarav Mehta", "author_role": "Founder, Crocon Home", "quote": "Walbayzon rebuilt our Amazon presence from the ground up. We 4× revenue in eight months without expanding our ad budget.", "rating": 5 } },
        { "type": "testimonial", "settings": { "author_name": "Priya Nair", "author_role": "CEO, Tindora Wellness", "quote": "The team feels like an extension of ours. Sharp creative, sharper numbers — and zero hand-holding required.", "rating": 5 } },
        { "type": "testimonial", "settings": { "author_name": "Kabir Singh", "author_role": "CMO, Norta Beauty", "quote": "From India to UAE in 90 days. The localisation playbook is genuinely best in class.", "rating": 5 } }
      ]
    }
  ]
}
{% endschema %}
