{% comment %}
  Walbayzon Hero Section
  Compatible with Shopify Theme Editor
{% endcomment %}

<section class="relative overflow-hidden py-16 sm:py-24 lg:py-32" style="background: {{ section.settings.bg_gradient }};">
  
  <!-- Glowing blob background -->
  <div class="absolute -top-32 left-1/2 -z-10 h-[500px] w-[800px] -translate-x-1/2 rounded-full opacity-20 blur-3xl" style="background-color: {{ section.settings.glow_color }};"></div>

  <!-- Floating Chat Birds Background Layer -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none select-none z-0">
    
    <!-- Bird 1 (Orange, fast path bottom-left to top-right) -->
    <div class="chat-bird bird-path-1 text-brand-orange">
      <div class="bird-body">
        <div class="wing left-wing">
          <svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full">
            <path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" />
          </svg>
        </div>
        <div class="bird-msg border-brand-orange/20 text-brand-coffee">
          +400% Revenue
        </div>
        <div class="wing right-wing">
          <svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full">
            <path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Bird 2 (Coffee, slow path bottom-right to top-left) -->
    <div class="chat-bird bird-path-2 text-brand-coffee">
      <div class="bird-body">
        <div class="wing left-wing">
          <svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full">
            <path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" />
          </svg>
        </div>
        <div class="bird-msg border-brand-coffee/20 text-brand-coffee">
          Zero hand-holding
        </div>
        <div class="wing right-wing">
          <svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full">
            <path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Bird 3 (Orange, floating left) -->
    <div class="chat-bird bird-path-3 text-brand-orange">
      <div class="bird-body">
        <div class="wing left-wing">
          <svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full">
            <path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" />
          </svg>
        </div>
        <div class="bird-msg border-brand-orange/20 text-brand-coffee">
          UAE in 90 Days
        </div>
        <div class="wing right-wing">
          <svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full">
            <path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Bird 4 (Coffee, floating right) -->
    <div class="chat-bird bird-path-4 text-brand-coffee">
      <div class="bird-body">
        <div class="wing left-wing">
          <svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full">
            <path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" />
          </svg>
        </div>
        <div class="bird-msg border-brand-coffee/20 text-brand-coffee">
          Global Scale
        </div>
        <div class="wing right-wing">
          <svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full">
            <path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Bird 5 (Orange, middle path left to right) -->
    <div class="chat-bird bird-path-5 text-brand-orange">
      <div class="bird-body">
        <div class="wing left-wing">
          <svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full">
            <path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" />
          </svg>
        </div>
        <div class="bird-msg border-brand-orange/20 text-brand-coffee">
          Amazon US & UK
        </div>
        <div class="wing right-wing">
          <svg viewBox="0 0 32 32" fill="currentColor" class="w-full h-full">
            <path d="M 4,4 h 24 a 4,4 0 0 1 4,4 v 12 a 4,4 0 0 1 -4,4 h -16 l -6,6 v -6 h -2 a 4,4 0 0 1 -4,-4 v -12 a 4,4 0 0 1 4,-4 z" />
          </svg>
        </div>
      </div>
    </div>

  </div>
  
  <div class="mx-auto max-w-7xl px-4 text-center fade-up relative z-10">
    
    <!-- Top badge -->
    {% if section.settings.badge_text != blank %}
      <div class="inline-flex items-center gap-2 rounded-full border border-border bg-background/60 px-3 py-1.5 text-[11px] font-medium text-foreground/70 backdrop-blur sm:px-4 sm:text-xs">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full opacity-75" style="background-color: {{ section.settings.badge_dot_color }};"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full" style="background-color: {{ section.settings.badge_dot_color }};"></span>
        </span>
        <span>{{ section.settings.badge_text }}</span>
      </div>
    {% endif %}

    <!-- Main heading -->
    <h1 class="mt-6 font-display text-[2.5rem] font-bold leading-[1.7] tracking-tight text-balance text-foreground sm:mt-7 sm:text-6xl md:text-7xl lg:text-[6.5rem] lg:leading-[1.6] hero-rotator-container">
      <span class="grid justify-center">
        <!-- Slide 1 -->
        <span class="hero-rotator-slide col-start-1 row-start-1 active transition-all duration-300">
          The #1 <span class="inline-block rounded-xl bg-brand-orange px-2 py-0 text-foreground shadow-[3px_3px_0_0_oklch(0.18_0.022_55)] sm:px-3 text-[0.85em] align-baseline hero-orange-block">Trusted partner</span> in <span class="inline-block rounded-xl bg-brand-orange px-2 py-0 text-foreground shadow-[3px_3px_0_0_oklch(0.18_0.022_55)] sm:px-3 text-[0.85em] align-baseline hero-orange-block">Brand Building</span>.
        </span>
        <!-- Slide 2 -->
        <span class="hero-rotator-slide col-start-1 row-start-1 pointer-events-none opacity-0 transition-all duration-300">
          The #1 <span class="inline-block rounded-xl bg-brand-orange px-2 py-0 text-foreground shadow-[3px_3px_0_0_oklch(0.18_0.022_55)] sm:px-3 text-[0.85em] align-baseline hero-orange-block">Top-rated expert</span> in <span class="inline-block rounded-xl bg-brand-orange px-2 py-0 text-foreground shadow-[3px_3px_0_0_oklch(0.18_0.022_55)] sm:px-3 text-[0.85em] align-baseline hero-orange-block">Global Scaling</span>.
        </span>
        <!-- Slide 3 -->
        <span class="hero-rotator-slide col-start-1 row-start-1 pointer-events-none opacity-0 transition-all duration-300">
          The #1 <span class="inline-block rounded-xl bg-brand-orange px-2 py-0 text-foreground shadow-[3px_3px_0_0_oklch(0.18_0.022_55)] sm:px-3 text-[0.85em] align-baseline hero-orange-block">Go-to choice</span> in <span class="inline-block rounded-xl bg-brand-orange px-2 py-0 text-foreground shadow-[3px_3px_0_0_oklch(0.18_0.022_55)] sm:px-3 text-[0.85em] align-baseline hero-orange-block">Worldwide Growth</span>.
        </span>
      </span>
    </h1>

    <!-- Subheading/Description -->
    <p class="mx-auto mt-6 max-w-2xl text-base text-muted-foreground sm:mt-7 sm:text-lg md:text-xl">
      {{ section.settings.subheading }}
    </p>

    <!-- Call to Actions -->
    <div class="mt-8 flex flex-col items-center justify-center gap-5 sm:mt-9 sm:flex-row">
      {% if section.settings.btn1_text != blank %}
        <div class="relative w-full sm:w-auto">
          <span aria-hidden class="absolute inset-0 translate-x-1.5 translate-y-1.5 rounded-full bg-foreground" style="background-color: {{ section.settings.shadow_color }};"></span>
          <a href="{{ section.settings.btn1_url }}" class="relative inline-flex w-full items-center justify-center rounded-full border-2 border-foreground bg-background px-6 py-3 text-base font-semibold text-foreground transition-transform duration-150 hover:translate-x-1.5 hover:translate-y-1.5 sm:w-auto">
            {{ section.settings.btn1_text }}
          </a>
        </div>
      {% endif %}
      {% if section.settings.btn2_text != blank %}
        <div class="relative w-full sm:w-auto">
          <span aria-hidden class="absolute inset-0 translate-x-1.5 translate-y-1.5 rounded-full bg-foreground" style="background-color: {{ section.settings.shadow_color }};"></span>
          <a href="{{ section.settings.btn2_url }}" class="relative inline-flex w-full items-center justify-center rounded-full border-2 border-foreground px-6 py-3 text-base font-semibold text-foreground transition-transform duration-150 hover:translate-x-1.5 hover:translate-y-1.5 sm:w-auto" style="background-color: {{ section.settings.btn2_bg }};">
            {{ section.settings.btn2_text }}
          </a>
        </div>
      {% endif %}
    </div>

    <!-- Rating info -->
    {% if section.settings.show_rating %}
      <div class="mt-10 flex flex-col items-center justify-center gap-3 text-sm text-muted-foreground sm:flex-row sm:gap-6">
        <div class="flex items-center gap-1.5" style="color: {{ section.settings.star_color }};">
          {% for i in (1..5) %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
          {% endfor %}
        </div>
        <span class="text-xs sm:text-sm">{{ section.settings.rating_text }}</span>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .hero-rotator-slide {
    opacity: 0;
    transform: scale(0.88) translateY(0);
    transition: opacity 0.8s ease-in-out, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hero-rotator-slide.active {
    opacity: 1 !important;
    transform: scale(1) translateY(0) !important;
    pointer-events: auto !important;
  }

  /* Flying Chat Birds styles */
  .chat-bird {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 600px;
    pointer-events: none;
    user-select: none;
    opacity: 0;
  }
  .bird-body {
    display: flex;
    align-items: center;
    justify-content: center;
    transform-style: preserve-3d;
    position: relative;
  }
  .wing {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
  }
  .left-wing {
    transform-origin: right center;
    transform: scaleX(-1);
    animation: flap-left 0.6s ease-in-out infinite;
  }
  .right-wing {
    transform-origin: left center;
    animation: flap-right 0.6s ease-in-out infinite;
  }
  .bird-msg {
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid;
    padding: 6px 18px;
    border-radius: 9999px;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.02em;
    box-shadow: 0 8px 12px -2px rgba(0,0,0,0.05), 0 4px 6px -2px rgba(0,0,0,0.03);
    backdrop-filter: blur(4px);
    white-space: nowrap;
    user-select: none;
    margin: 0 8px;
  }

  @keyframes flap-left {
    0% { transform: scaleX(-1) rotateY(0deg); }
    50% { transform: scaleX(-1) rotateY(55deg); }
    100% { transform: scaleX(-1) rotateY(0deg); }
  }
  @keyframes flap-right {
    0% { transform: rotateY(0deg); }
    50% { transform: rotateY(-55deg); }
    100% { transform: rotateY(0deg); }
  }

  /* Flight paths using responsive viewport widths (vw) */
  .bird-path-1 {
    animation: fly-path-1 14s linear infinite;
  }
  .bird-path-2 {
    animation: fly-path-2 18s linear infinite;
    animation-delay: 3s;
  }
  .bird-path-3 {
    animation: float-path-3 10s ease-in-out infinite;
  }
  .bird-path-4 {
    animation: float-path-4 12s ease-in-out infinite;
    animation-delay: 2s;
  }
  .bird-path-5 {
    animation: fly-path-5 12s linear infinite;
    animation-delay: 6s;
  }

  @keyframes fly-path-1 {
    0% { transform: translate(-20vw, 350px) scale(0.45) rotate(15deg); opacity: 0; }
    15% { opacity: 0.5; }
    85% { opacity: 0.5; }
    100% { transform: translate(110vw, -50px) scale(0.7) rotate(5deg); opacity: 0; }
  }
  @keyframes fly-path-2 {
    0% { transform: translate(110vw, 300px) scale(0.6) rotate(-20deg); opacity: 0; }
    15% { opacity: 0.45; }
    85% { opacity: 0.45; }
    100% { transform: translate(-20vw, 20px) scale(0.45) rotate(-5deg); opacity: 0; }
  }
  @keyframes float-path-3 {
    0% { transform: translate(10vw, 120px) scale(0.5) rotate(0deg); opacity: 0.4; }
    50% { transform: translate(18vw, 220px) scale(0.6) rotate(8deg); opacity: 0.6; }
    100% { transform: translate(10vw, 120px) scale(0.5) rotate(0deg); opacity: 0.4; }
  }
  @keyframes float-path-4 {
    0% { transform: translate(80vw, 240px) scale(0.55) rotate(5deg); opacity: 0.42; }
    50% { transform: translate(72vw, 100px) scale(0.5) rotate(-5deg); opacity: 0.52; }
    100% { transform: translate(80vw, 240px) scale(0.55) rotate(5deg); opacity: 0.42; }
  }
  @keyframes fly-path-5 {
    0% { transform: translate(-20vw, 80px) scale(0.55) rotate(5deg); opacity: 0; }
    15% { opacity: 0.55; }
    85% { opacity: 0.55; }
    100% { transform: translate(110vw, 220px) scale(0.7) rotate(10deg); opacity: 0; }
  }
</style>

<script>
  (function() {
    const initRotators = () => {
      const containers = document.querySelectorAll('.hero-rotator-container');
      containers.forEach((container) => {
        const slides = container.querySelectorAll('.hero-rotator-slide');
        if (slides.length === 0) return;
        
        if (container.heroRotatorInterval) {
          clearInterval(container.heroRotatorInterval);
        }
        
        let currentIndex = 0;
        slides.forEach((slide, idx) => {
          if (idx === 0) {
            slide.classList.add('active');
            slide.classList.remove('opacity-0', 'pointer-events-none');
          } else {
            slide.classList.remove('active');
            slide.classList.add('opacity-0', 'pointer-events-none');
          }
        });
        
        container.heroRotatorInterval = setInterval(() => {
          const currentSlide = slides[currentIndex];
          if (currentSlide) {
            currentSlide.classList.remove('active');
            currentSlide.classList.add('opacity-0', 'pointer-events-none');
          }
          
          currentIndex = (currentIndex + 1) % slides.length;
          
          const nextSlide = slides[currentIndex];
          if (nextSlide) {
            nextSlide.classList.add('active');
            nextSlide.classList.remove('opacity-0', 'pointer-events-none');
          }
        }, 4500);
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initRotators);
    } else {
      initRotators();
    }

    document.addEventListener('shopify:section:load', (e) => {
      if (e.target.querySelector('.hero-rotator-slide')) {
        initRotators();
      }
    });
  })();
</script>


{% schema %}
{
  "name": "Walbayzon Hero",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Trusted by 100+ category-leading brands"
    },
    {
      "type": "color",
      "id": "badge_dot_color",
      "label": "Badge Dot Color",
      "default": "#fc9f30"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading (HTML allowed)",
      "default": "The <span class=\"inline-block rounded-xl bg-brand-orange px-2 py-0 text-foreground shadow-[3px_3px_0_0_oklch(0.18_0.022_55)] sm:px-3 text-[0.85em] align-baseline\">#1 Trusted</span> partner in <span class=\"inline-block rounded-xl bg-brand-orange px-2 py-0 text-foreground shadow-[3px_3px_0_0_oklch(0.18_0.022_55)] sm:px-3 text-[0.85em] align-baseline\">Brand Building</span>"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Scale your business globally with Walbayzon — the marketplace growth partner behind India's most ambitious D2C brands."
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Button 1 Text",
      "default": "Get Started"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Button 1 URL"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Button 2 Text",
      "default": "See Our Services"
    },
    {
      "type": "url",
      "id": "btn2_url",
      "label": "Button 2 URL"
    },
    {
      "type": "color",
      "id": "btn2_bg",
      "label": "Button 2 Background Color",
      "default": "#fc9f30"
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Button Shadow Color",
      "default": "#1d1d1b"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating Stars",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "Rated 4.9 by founders across 12+ categories"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color",
      "default": "#fc9f30"
    },
    {
      "type": "text",
      "id": "bg_gradient",
      "label": "Section Background Gradient",
      "default": "linear-gradient(to bottom, oklch(0.98 0.02 75) 0%, oklch(0.94 0.03 72) 30%, oklch(0.98 0.02 75) 100%)"
    },
    {
      "type": "color",
      "id": "glow_color",
      "label": "Glowing Orb Background Color",
      "default": "#fc9f30"
    }
  ],
  "presets": [
    {
      "name": "Walbayzon Hero"
    }
  ]
}
{% endschema %}
